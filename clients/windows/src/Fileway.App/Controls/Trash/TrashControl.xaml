<UserControl x:Class="Fileway.App.Controls.Trash.TrashControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Trash" xmlns:ui="using:Fileway.App.Controls" KeyDown="Panel_KeyDown">
 <Grid Padding="20,16" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Height="40"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="回收站" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/><Button x:Name="RestoreButton" Click="Restore_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="恢复所选项目" AutomationProperties.Name="恢复所选项目"><ui:LucideIcon IconName="arrow-counter-clockwise" Width="20" Height="20"/></Button><Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource SubtleButtonStyle}" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新回收站"><ui:LucideIcon IconName="arrows-clockwise" Width="20" Height="20"/></Button></StackPanel></Grid>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Padding="56,8,16,8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><TextBlock Text="名称" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="大小" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="2" Text="删除时间" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
   <ListView x:Name="Records" Grid.Row="1" SelectionChanged="Selection_Changed" RightTapped="Records_RightTapped" DoubleTapped="Records_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.Name="回收站文件"><ListView.ItemTemplate><DataTemplate x:DataType="local:TrashRow"><Grid Padding="8,12" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><ui:LucideIcon IconName="{x:Bind IconName}" Width="28" Height="28"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"/><TextBlock Text="{x:Bind Status}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{x:Bind Size}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="3" Text="{x:Bind Deleted}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
   <TextBlock x:Name="Empty" Grid.Row="1" Text="回收站为空" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </Grid>
  <Expander x:Name="PendingPanel" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="需要核实的操作"><StackPanel Spacing="8"><ListView x:Name="UnknownRecords" SelectionChanged="Selection_Changed" DisplayMemberPath="Label" MaxHeight="150"/><Button x:Name="ReconcileButton" Content="核实所选操作" Click="Reconcile_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
  <InfoBar x:Name="Notice" Grid.RowSpan="3" IsOpen="False" IsClosable="True" Severity="Warning" HorizontalAlignment="Right" VerticalAlignment="Top" Width="380" Margin="0,52,0,0" Canvas.ZIndex="5"/>
 </Grid>
</UserControl>