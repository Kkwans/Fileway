<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Fileway.App.MainPage" xmlns:ui="using:Fileway.App.Controls" Background="Transparent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App" xmlns:collections="using:Fileway.App.Controls.Collections" xmlns:browser="using:Fileway.App.Controls.Browser" xmlns:transfers="using:Fileway.App.Controls.Transfers" xmlns:recent="using:Fileway.App.Controls.Recent" xmlns:search="using:Fileway.App.Controls.Search" xmlns:nasTasks="using:Fileway.App.Controls.NasTasks" xmlns:trash="using:Fileway.App.Controls.Trash" xmlns:storageTools="using:Fileway.App.Controls.StorageTools" xmlns:server="using:Fileway.App.Controls.Server" xmlns:settings="using:Fileway.App.Controls.Settings">
 <Page.Resources>
  <ResourceDictionary>

  <Style x:Key="ApplicationMenuItemStyle" TargetType="MenuBarItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="12,4"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="BrowserActionButtonStyle" TargetType="Button" BasedOn="{StaticResource FwIconButtonStyle}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style x:Key="TransferNoticeActionStyle" TargetType="Button" BasedOn="{StaticResource FwSecondaryButtonStyle}">
   <Setter Property="Background" Value="{ThemeResource FwSoftChoiceFillBrush}"/>
   <Setter Property="Foreground" Value="{ThemeResource FwSoftChoiceTextBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource FwStrokeStrongBrush}"/>
   <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="8,0"/>
  </Style>
  <!-- InfoBar drives these visual states and wires the CloseButton template part. -->
  <ControlTemplate x:Key="CompactNoticeTemplate" TargetType="InfoBar">
   <Border x:Name="ContentRoot" Background="{TemplateBinding Background}"
           BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
           CornerRadius="{TemplateBinding CornerRadius}">
    <VisualStateManager.VisualStateGroups>
     <VisualStateGroup x:Name="SeverityLevels">
      <VisualState x:Name="Informational"/>
      <VisualState x:Name="Success">
       <VisualState.Setters>
        <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconBackground}"/>
        <Setter Target="StandardIcon.Text" Value="&#xF13E;"/>
        <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarSuccessSeverityIconForeground}"/>
       </VisualState.Setters>
      </VisualState>
      <VisualState x:Name="Warning">
       <VisualState.Setters>
        <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconBackground}"/>
        <Setter Target="StandardIcon.Text" Value="&#xF13C;"/>
        <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarWarningSeverityIconForeground}"/>
       </VisualState.Setters>
      </VisualState>
      <VisualState x:Name="Error">
       <VisualState.Setters>
        <Setter Target="IconBackground.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconBackground}"/>
        <Setter Target="StandardIcon.Text" Value="&#xF13D;"/>
        <Setter Target="StandardIcon.Foreground" Value="{ThemeResource InfoBarErrorSeverityIconForeground}"/>
       </VisualState.Setters>
      </VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="IconStates">
      <VisualState x:Name="StandardIconVisible">
       <VisualState.Setters><Setter Target="StandardIconArea.Visibility" Value="Visible"/></VisualState.Setters>
      </VisualState>
      <VisualState x:Name="UserIconVisible">
       <VisualState.Setters><Setter Target="UserIconBox.Visibility" Value="Visible"/></VisualState.Setters>
      </VisualState>
      <VisualState x:Name="NoIconVisible"/>
     </VisualStateGroup>
     <VisualStateGroup>
      <VisualState x:Name="CloseButtonVisible"/>
      <VisualState x:Name="CloseButtonCollapsed">
       <VisualState.Setters><Setter Target="CloseButton.Visibility" Value="Collapsed"/></VisualState.Setters>
      </VisualState>
     </VisualStateGroup>
     <VisualStateGroup x:Name="InfoBarVisibility">
      <VisualState x:Name="InfoBarVisible"/>
      <VisualState x:Name="InfoBarCollapsed">
       <VisualState.Setters><Setter Target="ContentRoot.Visibility" Value="Collapsed"/></VisualState.Setters>
      </VisualState>
     </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid Padding="8,0,1,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <Grid x:Name="StandardIconArea" Visibility="Collapsed" VerticalAlignment="Center"
           AutomationProperties.AccessibilityView="Raw">
      <TextBlock x:Name="IconBackground" Text="&#xF136;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                 Foreground="{ThemeResource InfoBarInformationalSeverityIconBackground}"/>
      <TextBlock x:Name="StandardIcon" Text="&#xF13F;" FontSize="14" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                 Foreground="{ThemeResource InfoBarInformationalSeverityIconForeground}"/>
     </Grid>
     <Viewbox x:Name="UserIconBox" Width="14" Height="14" VerticalAlignment="Center" Visibility="Collapsed"
              Child="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.IconElement}"/>
     <TextBlock x:Name="Title" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding Title}"
                Foreground="{ThemeResource InfoBarTitleForeground}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <ContentPresenter Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding ActionButton}"/>
     <Button x:Name="CloseButton" Grid.Column="3" Width="26" Height="28" MinWidth="0" MinHeight="0"
             Margin="2,0,0,0" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center"
             AutomationProperties.AutomationId="CompactNoticeClose" AutomationProperties.Name="关闭通知"
             VerticalContentAlignment="Center" Background="{ThemeResource AppBarButtonBackground}"
             BorderBrush="{ThemeResource AppBarButtonBorderBrush}" Style="{TemplateBinding CloseButtonStyle}"
             Command="{TemplateBinding CloseButtonCommand}" CommandParameter="{TemplateBinding CloseButtonCommandParameter}">
      <Viewbox Width="12" Height="12" AutomationProperties.AccessibilityView="Raw">
       <SymbolIcon Symbol="Cancel"/>
      </Viewbox>
     </Button>
    </Grid>
   </Border>
  </ControlTemplate>
  <Style x:Key="BrowserNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource FwIconButtonStyle}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style x:Key="BrowserToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource FwIconButtonStyle}"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource FwNavigationButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="SidebarSelectedNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}"><Setter Property="Background" Value="{ThemeResource FwNavSelectedBackgroundBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource FwNavSelectedBorderBrush}"/><Setter Property="BorderThickness" Value="{ThemeResource FwNavSelectedBorderThickness}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="BrowserListItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource FwListViewItemStyle}"><Setter Property="MinHeight" Value="52"/></Style>
  <DataTemplate x:Key="BrowserGridTemplate" x:DataType="local:FileRow"><Grid Padding="10" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Width="{x:Bind VisualSize}" Height="{x:Bind VisualSize}" HorizontalAlignment="Center"><ui:LucideIcon x:Name="ThumbnailIcon" IconName="{x:Bind IconName}" Foreground="{ThemeResource FwTextSecondaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/><Image x:Name="ThumbnailImage" Width="{x:Bind VisualSize}" Height="{x:Bind VisualSize}" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></Grid>
   <Grid Grid.Row="1" MinHeight="40"><TextBlock Text="{x:Bind Name}" FontSize="13.5" TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" LineHeight="20" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/></Grid>
   <StackPanel Grid.Row="2" Spacing="2" Visibility="{x:Bind GridMetadataVisibility}"><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Summary}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Modified}" TextAlignment="Center"/></StackPanel>
  </Grid></DataTemplate>
  <DataTemplate x:Key="BrowserCompactListTemplate" x:DataType="local:FileRow"><Grid Padding="8,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="32" Height="32"><ui:LucideIcon x:Name="ThumbnailIcon" IconName="{x:Bind IconName}" Foreground="{ThemeResource FwTextSecondaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/><Image x:Name="ThumbnailImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></Grid>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Metadata}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Metadata}"/></StackPanel>
  </Grid></DataTemplate>
  </ResourceDictionary>
 </Page.Resources>
 <Grid x:Name="Shell" Background="Transparent" SizeChanged="Shell_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- MainWindow hosts the pane toggle and application menus together in the caption. -->
  <StackPanel x:Name="ApplicationCommandHost" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
   <Button x:Name="PaneButton" Style="{StaticResource BrowserNavigationButtonStyle}" Click="Pane_Click" AutomationProperties.Name="折叠导航侧栏" ToolTipService.ToolTip="折叠导航侧栏 (Ctrl+B)"><ui:LucideIcon IconName="sidebar-simple" Width="16" Height="16"/></Button>
   <MenuBar x:Name="ApplicationMenus" Height="40" MinHeight="40" Padding="0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" GettingFocus="ApplicationMenus_GettingFocus" PointerEntered="ApplicationMenus_PointerEntered" AutomationProperties.Name="应用菜单">
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="文件" AccessKey="F">
    <MenuFlyoutItem x:Name="MenuConnectionItem" Text="连接服务器…" Click="Connection_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuOpenItem" Text="打开" Click="DetailsOpen_Click" IsEnabled="False"/>
    <MenuFlyoutSubItem x:Name="MenuNewItem" Text="新建" IsEnabled="False"><MenuFlyoutItem Text="文件夹…" Click="CreateDirectory_Click"/><MenuFlyoutItem x:Name="MenuNewFileItem" Text="空文件…" Click="CreateEmptyFile_Click"/></MenuFlyoutSubItem>
    <MenuFlyoutItem x:Name="MenuUploadItem" Text="上传文件…" Click="UploadFile_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuDownloadItem" Text="下载到默认目录…" Click="DownloadFile_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuSaveAsItem" Text="下载另存为…" Click="DownloadSaveAs_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="LogoutButton" Text="退出登录" Visibility="Collapsed" Click="Logout_Click"/>
    <MenuFlyoutItem Text="退出" Click="ApplicationExit_Click"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="编辑" AccessKey="E">
    <MenuFlyoutItem x:Name="MenuClipboardCopyItem" Text="复制" Click="CopyClipboard_Click" KeyboardAcceleratorTextOverride="Ctrl+C" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClipboardCutItem" Text="剪切" Click="CutClipboard_Click" KeyboardAcceleratorTextOverride="Ctrl+X" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClipboardPasteItem" Text="粘贴" Click="PasteClipboard_Click" KeyboardAcceleratorTextOverride="Ctrl+V" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuRenameItem" Text="重命名…" Click="Rename_Click" KeyboardAcceleratorTextOverride="F2" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuCopyItem" Text="复制到…" Click="CopySelection_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuMoveItem" Text="移动到…" Click="MoveSelection_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTrashItem" Text="移入回收站…" Click="Trash_Click" KeyboardAcceleratorTextOverride="Delete" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuSelectAllItem" Text="全选" Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClearSelectionItem" Text="取消选择" Click="ClearSelection_Click" IsEnabled="False"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="视图" AccessKey="V">
    <MenuFlyoutItem x:Name="MenuRefreshItem" Text="刷新" Click="Refresh_Click" KeyboardAcceleratorTextOverride="F5" IsEnabled="False"/>
    <ToggleMenuFlyoutItem x:Name="MenuDetailsItem" Text="详细信息" Click="Details_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutSubItem x:Name="MenuLayoutItem" Text="文件布局" IsEnabled="False">
     <RadioMenuFlyoutItem x:Name="MenuMosaicItem" Text="详细网格" Tag="Mosaic" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuCompactGridItem" Text="紧凑网格" Tag="CompactGrid" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuWindowsIconsItem" Text="无界网格" Tag="WindowsIcons" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuDetailsViewItem" Text="详细列表" Tag="Details" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuCompactListItem" Text="紧凑列表" Tag="CompactList" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
    </MenuFlyoutSubItem>
    <MenuFlyoutSubItem Text="界面主题"><RadioMenuFlyoutItem x:Name="MenuSystemThemeItem" Text="跟随系统" Tag="Default" GroupName="ApplicationTheme" IsChecked="True" Click="ApplicationTheme_Click"/><RadioMenuFlyoutItem x:Name="MenuLightThemeItem" Text="浅色" Tag="Light" GroupName="ApplicationTheme" Click="ApplicationTheme_Click"/><RadioMenuFlyoutItem x:Name="MenuDarkThemeItem" Text="深色" Tag="Dark" GroupName="ApplicationTheme" Click="ApplicationTheme_Click"/></MenuFlyoutSubItem>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="工具" AccessKey="T">
    <MenuFlyoutItem Text="外观与交互…" Click="PresentationSettings_Click"/><MenuFlyoutItem Text="打开方式…" Click="OpenWithSettings_Click"/><ToggleMenuFlyoutItem x:Name="MenuCloseToTrayItem" Text="关闭窗口后保留在托盘" IsChecked="True" Click="CloseToTray_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuServerSearchItem" Text="搜索文件…" Click="ServerSearch_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuRecentItem" Text="最近访问" Click="RecentAccess_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTransfersItem" Text="传输中心" Click="TransferCenter_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuNasTasksItem" Text="文件任务" Click="NasTasks_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTrashPageItem" Text="回收站" Click="TrashPage_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuLocalServerItem" Text="本地服务端…" Click="LocalServer_Click"/>
    <MenuFlyoutItem x:Name="CollectionsButton" Text="管理收藏与标签…" Click="Collections_Click" IsEnabled="False" AutomationProperties.Name="管理收藏与标签"/>
    <MenuFlyoutItem x:Name="MenuShareManagerItem" Text="分享管理…" Click="ShareManager_Click" IsEnabled="False" AutomationProperties.Name="分享管理"/>
    <MenuFlyoutItem x:Name="ChangePasswordButton" Text="修改密码…" Click="ChangePassword_Click" Visibility="Collapsed" AutomationProperties.Name="修改当前账户密码"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="StorageSettingsButton" Text="缓存与存储…" Click="StorageSettings_Click" IsEnabled="False" AutomationProperties.Name="缓存与存储设置"/>
    <MenuFlyoutItem Text="设置…" Click="Settings_Click" AutomationProperties.Name="打开设置页"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="帮助" AccessKey="H"><MenuFlyoutItem Text="键盘快捷键" Click="KeyboardHelp_Click"/><MenuFlyoutItem Text="关于" Click="AboutApplication_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="LanguageFollowItem" Text="语言：跟随系统" Click="LanguageFollow_Click"/><MenuFlyoutItem x:Name="LanguageChineseItem" Text="语言：简体中文" Click="LanguageChinese_Click"/><MenuFlyoutItem x:Name="LanguageEnglishItem" Text="Language: English（部分翻译）" Click="LanguageEnglish_Click"/></MenuBarItem>
   </MenuBar>
  </StackPanel>
  <Border x:Name="ContentBackdrop" Grid.Column="1" Grid.RowSpan="2" Background="{ThemeResource FileContentSurfaceBrush}" BorderThickness="0" CornerRadius="8,0,0,0" IsHitTestVisible="False"/>
  <Grid x:Name="NavigationHeader" Grid.Column="1" Height="64" Padding="16,10" ColumnSpacing="8" Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <ContentControl VerticalContentAlignment="Center" VerticalAlignment="Center" x:Name="NavigationCommands" IsEnabled="False" IsTabStop="False"><StackPanel Orientation="Horizontal" Spacing="4">
     <Button x:Name="BackButton" Style="{StaticResource BrowserToolbarButtonStyle}" Click="Back_Click" IsEnabled="False" AutomationProperties.Name="返回" ToolTipService.ToolTip="返回 (Alt+Left)"><ui:LucideIcon IconName="arrow-left" Width="16" Height="16"/></Button>
     <Button x:Name="UpButton" Style="{StaticResource BrowserToolbarButtonStyle}" Click="Up_Click" IsEnabled="False" AutomationProperties.Name="上一级" ToolTipService.ToolTip="上一级 (Alt+Up)"><ui:LucideIcon IconName="arrow-up" Width="16" Height="16"/></Button>
     <Button Style="{StaticResource BrowserToolbarButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="刷新目录" ToolTipService.ToolTip="刷新 (F5)"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/></Button>
    </StackPanel></ContentControl>
   </StackPanel>
   <Grid Grid.Column="1" MinWidth="120">
    <Border x:Name="PathLocationHost" Height="40" Padding="4,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0" CornerRadius="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <BreadcrumbBar x:Name="PathBreadcrumb" Height="40" VerticalContentAlignment="Center" MinHeight="0" Padding="4,0" FontSize="14" ItemClicked="Breadcrumb_Click" VerticalAlignment="Center" AutomationProperties.Name="目录导航"><BreadcrumbBar.ItemTemplate><DataTemplate><BreadcrumbBarItem Content="{Binding Label}" Height="36" MinHeight="36" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0"/></DataTemplate></BreadcrumbBar.ItemTemplate></BreadcrumbBar>
      <TextBox x:Name="PathBox" Grid.ColumnSpan="2" Visibility="Collapsed" Height="32" MinHeight="32" Padding="8,4" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus" AutomationProperties.Name="原始路径，按 Enter 导航，Escape 取消" PlaceholderText="原始路径（保留百分号编码）" ToolTipService.ToolTip="原始路径；保留服务器返回的百分号编码。Enter 导航，Escape 取消。"/>
      <Button x:Name="EditPathButton" Grid.Column="1" Style="{StaticResource BrowserNavigationButtonStyle}" Click="EditPath_Click" AutomationProperties.Name="编辑原始路径" ToolTipService.ToolTip="编辑原始路径 (Ctrl+L)"><ui:LucideIcon IconName="pencil-simple" Width="16" Height="16"/></Button>
     </Grid>
    </Border>
    <TextBlock x:Name="WorkspaceTitle" Text="连接服务器" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <Button x:Name="BrowserSearchButton" Grid.Column="2" Style="{StaticResource BrowserToolbarButtonStyle}"
           Click="BrowserSearch_Click" AutomationProperties.Name="筛选与搜索文件" ToolTipService.ToolTip="筛选与搜索文件 (Ctrl+F)">
    <Grid Width="24" Height="24">
     <ui:LucideIcon IconName="magnifying-glass" Width="18" Height="18"/>
     <Ellipse x:Name="BrowserFilterIndicator" Visibility="Collapsed" Width="6" Height="6"
              HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
    </Grid>
   </Button>
   <Popup x:Name="BrowserSearchPopup" PlacementTarget="{x:Bind BrowserToolbar}" DesiredPlacement="Bottom" VerticalOffset="4"
          IsLightDismissEnabled="True" LightDismissOverlayMode="Off" Opened="BrowserSearch_Opened" Closed="BrowserSearch_Closed">
    <Border x:Name="BrowserSearchSurface" Style="{StaticResource FwSearchPopupSurfaceStyle}"
            PreviewKeyDown="BrowserSearchSurface_PreviewKeyDown" AutomationProperties.AutomationId="BrowserSearchSurface">
     <Grid RowSpacing="8" ColumnSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" Height="36" MinHeight="36" Style="{StaticResource FilewaySearchBoxStyle}"
                      PlaceholderText="输入文件名" TextChanged="Search_Changed" QuerySubmitted="Search_QuerySubmitted"
                      AutomationProperties.Name="输入筛选当前列表，按 Enter 搜索当前目录及子目录">
       <AutoSuggestBox.QueryIcon><ui:LucideActionIcon IconName="magnifying-glass"/></AutoSuggestBox.QueryIcon>
      </AutoSuggestBox>
      <Button Grid.Column="1" Style="{StaticResource FwIconButtonStyle}" Click="CloseBrowserSearch_Click"
              AutomationProperties.Name="关闭文件搜索" ToolTipService.ToolTip="关闭 (Esc)">
       <ui:LucideIcon IconName="x" Width="16" Height="16"/>
      </Button>
      <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="2,0,2,1" Style="{StaticResource FwCaptionTextStyle}"
                 Text="输入即筛选当前列表  ·  Enter 搜索含子目录" TextWrapping="Wrap"/>
     </Grid>
    </Border>
   </Popup>
  </Grid>
  <Grid x:Name="Sidebar" Grid.RowSpan="2" Padding="12,16,12,12" Background="Transparent" Canvas.ZIndex="3">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="SidebarOverlayBackground" Grid.RowSpan="2" Margin="-12,-16,-12,-12" Background="{ThemeResource FileContentSurfaceBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
   <ScrollViewer x:Name="SidebarNavigationScroll" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
    <StackPanel Spacing="4">
     <Button x:Name="MyFilesButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="Root_Click" AutomationProperties.Name="我的文件根目录" ToolTipService.ToolTip="我的文件"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="folder" Width="16" Height="16"/><TextBlock x:Name="MyFilesLabel" Text="我的文件"/></StackPanel></Button>
     <Button x:Name="RecentAccessButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="RecentAccess_Click" IsEnabled="False" AutomationProperties.Name="最近访问" ToolTipService.ToolTip="最近访问"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="clock" Width="16" Height="16"/><TextBlock x:Name="RecentAccessLabel" Text="最近访问"/></StackPanel></Button>
     <Button x:Name="TransferCenterButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="TransferCenter_Click" IsEnabled="False" AutomationProperties.Name="传输中心" ToolTipService.ToolTip="传输中心"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="arrow-down-up" Width="16" Height="16"/><TextBlock x:Name="TransferCenterLabel" Text="传输中心"/></StackPanel></Button>
     <Button x:Name="NasTasksButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="NasTasks_Click" IsEnabled="False" AutomationProperties.Name="文件任务" ToolTipService.ToolTip="文件任务"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="file-code" Width="16" Height="16"/><TextBlock x:Name="NasTasksLabel" Text="文件任务"/></StackPanel></Button>
     <Button x:Name="StorageToolsButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="StorageTools_Click" IsEnabled="False" AutomationProperties.Name="存储工具" ToolTipService.ToolTip="存储工具"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="hard-drive" Width="16" Height="16"/><TextBlock x:Name="StorageToolsLabel" Text="存储工具"/></StackPanel></Button>
