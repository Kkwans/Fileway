<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Recent.RecentAccessControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Fileway.App">
 <Grid Padding="20,12,20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="最近访问" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="当前账号的服务器记录，最多保留 100 条" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="1" Content="返回文件" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开最近访问，返回文件"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="OpenSelectedButton" Content="打开" HorizontalAlignment="Left" IsEnabled="False" Click="Open_Click" Style="{StaticResource FwSecondaryButtonStyle}" ToolTipService.ToolTip="打开选中资源 (Enter)" AutomationProperties.Name="打开选中的最近访问资源"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="RecentLoadingRing" Width="20" Height="20" IsActive="False" AutomationProperties.Name="正在读取最近访问"/><Button x:Name="RecentRefreshButton" Click="Refresh_Click" Style="{StaticResource FwIconButtonStyle}" Width="34" Height="34" AutomationProperties.Name="刷新最近访问" ToolTipService.ToolTip="刷新最近访问 (F5)"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/></Button></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="8"><TextBlock Visibility="Collapsed" Text="记录保留服务器顺序和访问时间。历史路径不保证文件仍存在；明确打开时会先核对当前资源。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><InfoBar x:Name="RecentError" IsOpen="False" IsClosable="False" Severity="Warning" Title="最近访问需要处理"/></StackPanel>
  <Grid Grid.Row="3">
   <ListView x:Name="RecentRecords" SelectionMode="Single" SelectionChanged="Record_Changed" DoubleTapped="Records_DoubleTapped" KeyDown="Records_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="最近访问列表，选中后按 Enter 打开">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="local:RecentAccessRow"><StackPanel Padding="12,10" Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName}"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/><TextBlock Text="{x:Bind DisplayPath}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind DisplayPath}"/><TextBlock Text="{x:Bind AccessedTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind IdentityHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel x:Name="RecentEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="14" Margin="12"><Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Background="{ThemeResource FwSurfaceBrush}" BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="1"><ui:LucideIcon IconName="clock" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource FwTextSecondaryBrush}"/></Border><TextBlock x:Name="RecentEmptyTitle" Text="暂无最近访问" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource FwTextPrimaryBrush}"/><TextBlock x:Name="RecentEmptyText" Text="成功打开远端图片或视频后，可刷新查看服务器记录。" FontSize="13" LineHeight="20" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource FwTextSecondaryBrush}"/></StackPanel>
  </Grid>
  <TextBlock x:Name="RecentCount" Grid.Row="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
