<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.NasTasks.NasTasksControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Fileway.App.Controls.NasTasks" KeyDown="Panel_KeyDown">
 <Grid x:Name="PanelRoot" Padding="20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="文件任务" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="当前账号在服务器执行的复制、移动任务。本机上传与下载请查看传输中心。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="1" Content="返回文件" VerticalAlignment="Center" Click="Close_Click" AutomationProperties.Name="离开 文件任务，返回文件"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="TasksTab" Content="服务器任务" IsChecked="True" Click="TasksTab_Click"/><ToggleButton x:Name="HistoryTab" Content="操作记录与核实" Click="HistoryTab_Click"/></StackPanel>
   <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="20" Height="20" IsActive="False" AutomationProperties.Name="正在读取 NAS 任务或核实操作记录"/>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="8">
   <CommandBar x:Name="Commands" DefaultLabelPosition="Right" Background="Transparent" IsDynamicOverflowEnabled="True">
    <AppBarButton x:Name="RefreshButton" Label="刷新任务" Click="Refresh_Click" ToolTipService.ToolTip="刷新 (F5)"><AppBarButton.Icon><PathIcon Data="{StaticResource Phosphor-arrows-clockwise}"/></AppBarButton.Icon></AppBarButton>
    <AppBarButton x:Name="DetailRefreshButton" Label="刷新详情" Click="DetailRefresh_Click"><AppBarButton.Icon><PathIcon Data="{StaticResource Phosphor-eye}"/></AppBarButton.Icon></AppBarButton>
    <AppBarButton x:Name="ReconcileButton" Label="核实记录" Icon="Sync" Click="Reconcile_Click" Visibility="Collapsed"/>
    <AppBarSeparator x:Name="TaskActionSeparator"/>
    <AppBarButton x:Name="CancelTaskButton" Label="请求取消" Icon="Cancel" Click="CancelTask_Click"/>
    <AppBarButton x:Name="RetryTaskButton" Label="重试" Click="RetryTask_Click"><AppBarButton.Icon><PathIcon Data="{StaticResource Phosphor-arrows-clockwise}"/></AppBarButton.Icon></AppBarButton>
    <CommandBar.SecondaryCommands>
     <AppBarButton x:Name="ArchiveTaskButton" Label="归档记录" Click="ArchiveTask_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE7B8;"/></AppBarButton.Icon></AppBarButton>
     <AppBarButton x:Name="UnarchiveTaskButton" Label="移出归档" Click="UnarchiveTask_Click"><AppBarButton.Icon><PathIcon Data="{StaticResource Phosphor-arrow-counter-clockwise}"/></AppBarButton.Icon></AppBarButton>
    </CommandBar.SecondaryCommands>
   </CommandBar>
   <Grid x:Name="Filters" ColumnSpacing="8" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ui:ChoiceBox x:Name="StatusFilter" Header="任务状态" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed" AutomationProperties.Name="筛选 文件任务状态">
     <ComboBoxItem Content="全部状态"/><ComboBoxItem Content="进行中"/><ComboBoxItem Content="需要处理"/><ComboBoxItem Content="已完成"/><ComboBoxItem Content="已取消"/>
    </ui:ChoiceBox>
    <ui:ChoiceBox x:Name="TypeFilter" Grid.Column="1" Header="任务类型" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Filter_Changed"><ComboBoxItem Content="全部类型"/><ComboBoxItem Content="复制"/><ComboBoxItem Content="移动"/></ui:ChoiceBox>
    <CheckBox x:Name="ArchivedFilter" Grid.Column="2" Content="已归档" VerticalAlignment="Bottom" Checked="Archived_Changed" Unchecked="Archived_Changed"/>
   </Grid>
  </StackPanel>
  <StackPanel Grid.Row="3" Spacing="8">
   <InfoBar x:Name="Notice" IsOpen="False" IsClosable="False" Severity="Informational" Title="任务状态"><InfoBar.ActionButton><Button x:Name="NoticeHistoryButton" Content="查看操作记录" Click="HistoryTab_Click"/></InfoBar.ActionButton></InfoBar>
   <TextBlock x:Name="AuthorityHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <Grid x:Name="Body" Grid.Row="4" ColumnSpacing="16" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailColumn" Width="360"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="ListArea">
    <ListView x:Name="TaskRecords" SelectionMode="Single" SelectionChanged="Task_Changed" KeyDown="TaskRecords_KeyDown" DoubleTapped="TaskRecords_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.Name="NAS 服务器文件任务，按 Enter 刷新详情">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="local:NasTaskRow">
      <Grid Padding="8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
       <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/><TextBlock Text="{x:Bind Status, Mode=OneWay}"/><TextBlock Text="{x:Bind ProgressText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind When, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </Grid>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
    <ListView x:Name="OperationRecords" Visibility="Collapsed" SelectionMode="Single" SelectionChanged="Operation_Changed" KeyDown="OperationRecords_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="任务操作记录，按 Enter 核实选中记录">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="local:NasTaskOperationRow"><StackPanel Spacing="4" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Stage, Mode=OneWay}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind When, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="8" Margin="12"><ui:PhosphorIcon IconName="file-code" Width="32" Height="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="EmptyTitle" Text="暂无 文件任务" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
   <Border x:Name="DetailsPane" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="16,4,0,4">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="12">
      <TextBlock x:Name="DetailTitle" Text="任务详情" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="DetailPlaceholder" Text="选中任务查看服务器状态、进度与可用操作。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <StackPanel x:Name="TaskDetails" Spacing="10" Visibility="Collapsed">
       <TextBlock x:Name="DetailStatus" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <ProgressBar x:Name="DetailProgress" Minimum="0" Maximum="100" Height="4" AutomationProperties.Name="服务器任务进度"/>
       <TextBlock x:Name="DetailProgressText" TextWrapping="Wrap"/><TextBlock x:Name="DetailTimes" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock x:Name="DetailPaths" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <TextBlock x:Name="DetailError" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="服务器未提供逐项执行结果。已处理数量不能说明哪些文件已成功。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Button x:Name="RelatedHistoryButton" Content="查看关联操作记录" Click="RelatedHistory_Click" HorizontalAlignment="Left"/>
       <Button x:Name="NewRetryButton" Content="查看新重试任务" Click="NewRetry_Click" HorizontalAlignment="Left" Visibility="Collapsed"/>
       <Expander Header="任务编号" HorizontalAlignment="Stretch"><TextBlock x:Name="DetailTaskId" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
      </StackPanel>
      <StackPanel x:Name="OperationDetails" Spacing="10" Visibility="Collapsed">
       <TextBlock x:Name="OperationStage" TextWrapping="Wrap"/><TextBlock x:Name="OperationExplanation" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <TextBlock Text="操作记录逐项确认" FontWeight="SemiBold"/><TextBlock Text="提交记录不代替服务器逐项执行结果；未确认项不会标为成功。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ListView x:Name="OperationItems" Height="220" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch" AutomationProperties.Name="操作记录中的逐项确认">
        <ListView.ItemTemplate><DataTemplate x:DataType="local:NasTaskOperationItemRow"><StackPanel Padding="4,8" Spacing="3"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Outcome}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Source}" FontSize="12" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind Source}"/><TextBlock Text="{x:Bind Target}" FontSize="12" TextWrapping="Wrap" MaxLines="2" ToolTipService.ToolTip="{x:Bind Target}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
       </ListView>
       <TextBlock x:Name="OperationItemsEmpty" Text="此记录未提供逐项确认。" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <Expander Header="记录信息" HorizontalAlignment="Stretch"><TextBlock x:Name="OperationIdentity" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></Expander>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Grid Grid.Row="5" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LoadedText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/><Button x:Name="MoreButton" Grid.Column="1" Content="加载更多" Click="More_Click" Visibility="Collapsed"/></Grid>
 </Grid>
</UserControl>
