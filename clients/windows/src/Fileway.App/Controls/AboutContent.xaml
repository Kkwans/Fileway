<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.AboutContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="460">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="14" Background="{ThemeResource FwSurfaceRaisedBrush}"
                    BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="1">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png"
                       Width="40" Height="40" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="栖卷 Fileway" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Windows 原生文件客户端" FontSize="12" Foreground="{ThemeResource FwTextSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <Border Background="{ThemeResource FwSurfaceBrush}" BorderBrush="{ThemeResource FwStrokeBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="版本" FontSize="12" Foreground="{ThemeResource FwTextSecondaryBrush}" />
                    <TextBlock x:Name="VersionText" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="本地未签名预览" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource FwTextSecondaryBrush}" />
            </Grid>
        </Border>
        <Border Style="{StaticResource FwFormCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock Text="应用更新" FontWeight="SemiBold"/>
                <TextBlock Text="版本来源：栖卷在 GitHub 上的公开 Windows x64 发布。" Style="{StaticResource FwCaptionTextStyle}" TextWrapping="Wrap"/>
                <TextBlock x:Name="UpdateStatus" Text="可手动检查可用版本。" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="AppUpdateStatus" AutomationProperties.LiveSetting="Polite"/>
                <ProgressBar x:Name="UpdateProgress" IsIndeterminate="False" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <HyperlinkButton x:Name="ReleaseLink" Content="查看发布" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="OpenWindowsRelease"/>
                    <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click"
                            Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.AutomationId="CheckAppUpdate"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="项目主页与源代码" Click="OpenSource_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                    Height="32" Padding="12,0" FontSize="13" />
            <Button Content="许可证" Click="OpenLicense_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                    Height="32" Padding="12,0" FontSize="13" />
        </StackPanel>
        <TextBlock Text="文件浏览、预览与传输均在本机完成；登录凭据保存在当前 Windows 用户下。"
                   FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FwTextSecondaryBrush}" />
    </StackPanel>
</UserControl>
