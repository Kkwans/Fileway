<UserControl x:Class="Fileway.App.Controls.Trash.TrashControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Trash" KeyDown="Panel_KeyDown">
 <Grid Padding="20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="回收站" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="当前账号的服务器回收站。恢复前确认同名冲突策略。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Content="返回文件" Click="Close_Click"/></Grid>
  <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right"><AppBarButton x:Name="RefreshButton" Label="刷新" Icon="Refresh" Click="Refresh_Click"/><AppBarButton x:Name="RestoreButton" Label="恢复所选项目" Icon="Undo" Click="Restore_Click"/><CommandBar.Content><ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/></CommandBar.Content></CommandBar>
  <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="False" Severity="Warning"/>
  <Grid x:Name="Body" Grid.Row="3" ColumnSpacing="16" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="320"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="ListArea"><ListView x:Name="Records" SelectionChanged="Selection_Changed" HorizontalContentAlignment="Stretch" AutomationProperties.Name="当前账号回收站项目"><ListView.ItemTemplate><DataTemplate x:DataType="local:TrashRow"><StackPanel Padding="8,10" Spacing="4"><TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Path}"/><TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView><TextBlock x:Name="Empty" Text="回收站为空" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
   <ScrollViewer x:Name="Details" Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><TextBlock Text="项目详情" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DetailText" Text="选择项目查看详情" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><ComboBox x:Name="ConflictBox" Header="同名冲突" SelectedIndex="0" SelectionChanged="Conflict_Changed" HorizontalAlignment="Stretch"><ComboBoxItem Content="报告冲突，不覆盖"/><ComboBoxItem Content="保留两份"/><ComboBoxItem Content="替换目标（需删除权限）"/><ComboBoxItem Content="跳过同名项目"/></ComboBox><TextBlock Text="仅恢复到服务器原位置；不会把显示路径当作文件身份。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="待核实的恢复操作" FontWeight="SemiBold"/><ListView x:Name="UnknownRecords" SelectionChanged="Selection_Changed" DisplayMemberPath="Label" MaxHeight="180"/><Button x:Name="ReconcileButton" Content="核实所选记录" Click="Reconcile_Click" HorizontalAlignment="Left"/><TextBlock Text="核实只读取原操作证据，不会重新提交恢复。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
