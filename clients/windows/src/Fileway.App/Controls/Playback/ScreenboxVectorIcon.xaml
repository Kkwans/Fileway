<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Playback.ScreenboxVectorIcon" x:Name="IconRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="20" Height="20" IsHitTestVisible="False" IsTabStop="False"
    AutomationProperties.AccessibilityView="Raw">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="ms-appx:///Controls/Playback/ScreenboxVectorResources.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <!-- Preserve the source SVG viewBox; fitting the tight path bounds would
         change optical size and line weight from one icon to the next. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="20" Height="20">
            <Canvas Width="20" Height="20">
                <Path x:Name="Artwork" Width="20" Height="20" Stretch="None" Fill="{Binding Foreground, ElementName=IconRoot}"/>
            </Canvas>
            <TextBlock x:Name="ResourceError" Text="!" Visibility="Collapsed" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="图标资源加载失败"/>
        </Grid>
    </Viewbox>
</UserControl>
