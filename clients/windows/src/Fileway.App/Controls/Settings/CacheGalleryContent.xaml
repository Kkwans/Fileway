<UserControl x:Class="Fileway.App.Controls.Settings.CacheGalleryContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" MinWidth="380" MaxWidth="480">
        <TextBlock Text="当前账户的本机缩略图，可在断网时查看。"
                   Style="{StaticResource FwCaptionTextStyle}" TextWrapping="Wrap"/>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="CacheGalleryStatus" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="GalleryActions" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <StackPanel x:Name="Pager" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                    <Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                            AutomationProperties.AutomationId="PreviousCacheGalleryPage"/>
                    <Button x:Name="NextButton" Content="下一页" Click="Next_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                            AutomationProperties.AutomationId="NextCacheGalleryPage"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                        AutomationProperties.AutomationId="RefreshCacheGallery"/>
            </StackPanel>
            <Button x:Name="BackButton" Grid.Column="1" Content="返回图库" Click="Back_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                    VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.AutomationId="ReturnToCacheGallery"/>
        </Grid>
        <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed"/>
        <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        </Grid>
        <Border x:Name="PreviewSurface" Visibility="Collapsed" Style="{StaticResource FwFormCardStyle}">
            <Image x:Name="PreviewImage" Height="216" Stretch="Uniform" AutomationProperties.Name="本机缓存缩略图预览"/>
        </Border>
    </StackPanel>
</UserControl>
