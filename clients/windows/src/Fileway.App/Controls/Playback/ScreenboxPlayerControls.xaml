<?xml version="1.0" encoding="utf-8"?>
<!-- Screenbox 6870eb0 layout/resource adaptation. The button ControlTemplate is
     transplanted in ScreenboxButtonResources.xaml; session binding is Fileway code.
     GPL-3.0 and Microsoft MIT notices: clients/windows/licenses/screenbox-ui.md. -->
<UserControl x:Class="Fileway.App.Controls.Playback.ScreenboxPlayerControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fileway.App.Controls.Playback" RequestedTheme="Dark">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Controls/Playback/ScreenboxButtonResources.xaml" />
                <ResourceDictionary Source="ms-appx:///Controls/Playback/ScreenboxVectorResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PlayerForeground" Color="#F0FFFFFF" />
                    <SolidColorBrush x:Key="PlayerSecondary" Color="#C8FFFFFF" />
                    <SolidColorBrush x:Key="PlayerAccent" Color="#69A8FF" />
                    <!-- Screenbox video-edge masks fade into the picture. -->
                    <LinearGradientBrush x:Key="PlayerTopGradient" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#99000000" />
                        <GradientStop Offset="0.5" Color="#33000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PlayerBottomGradient" StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#99000000" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PlayerFallbackSurface" Color="#202020" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#55FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#70FFFFFF" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#70FFFFFF" />
                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="PlayerAccent" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="PlayerAccent" />
                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="PlayerAccent" />
                    <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="White" />
                    <StaticResource x:Key="SliderThumbBackground" ResourceKey="PlayerAccent" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="PlayerAccent" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="PlayerAccent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PlayerForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PlayerSecondary" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PlayerAccent" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="PlayerTopGradient" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PlayerBottomGradient" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PlayerFallbackSurface" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="SliderTrackFill" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="SliderTrackFillPointerOver" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="SliderTrackFillPressed" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="SliderTrackValueFill" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="SliderOuterThumbBackground" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="SliderThumbBackground" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                    <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Screenbox SeekBar uses SDK DefaultSliderStyle. Preserve its native
                 automation/thumb/keyboard template; specialize supported tokens. -->
            <x:Double x:Key="SliderTrackThemeHeight">3</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">2</CornerRadius>
            <Style x:Key="PlayerFlyoutStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
                <Setter Property="RequestedTheme" Value="Dark" />
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="0" />
                <Setter Property="MaxWidth" Value="420" /><Setter Property="MaxHeight" Value="600" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>
            <!-- Screenbox Styles/Flyout.xaml: native MenuFlyout padding. -->
            <Style x:Key="PlayerMenuFlyoutStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
                <Setter Property="RequestedTheme" Value="Dark" />
                <Setter Property="Background" Value="{ThemeResource AcrylicInAppFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="Padding" Value="{StaticResource MenuFlyoutPresenterThemePadding}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinWidth" Value="280" /><Setter Property="MaxWidth" Value="420" />
            </Style>
            <!-- Enable only with the native acrylic backdrop supplied by the
                 owner. The normal styles above remain the App Acrylic fallback. -->
            <Style x:Key="PlayerHostFlyoutStyle" TargetType="FlyoutPresenter" BasedOn="{StaticResource PlayerFlyoutStyle}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="PlayerHostMenuFlyoutStyle" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource PlayerMenuFlyoutStyle}">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="PlayerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="16,8" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown" PointerMoved="Root_PointerMoved" PointerPressed="Root_PointerPressed">
        <!-- Screenbox PlayerControls' expanded/AdaptiveHidden/compact pattern:
             overflow real secondary actions instead of wrapping the toolbar. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="Expanded">
                    <VisualState.Setters>
                        <Setter Target="AdaptiveTools.Visibility" Value="Visible"/>
                        <Setter Target="ChapterContainer.Visibility" Value="Visible"/>
                        <Setter Target="InlineVolumeHost.Visibility" Value="Visible"/>
                        <Setter Target="VolumeButton.Visibility" Value="Collapsed"/>
                        <Setter Target="MoreButton.Visibility" Value="Collapsed"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="AdaptiveHidden">
                    <VisualState.Setters>
                        <Setter Target="AdaptiveTools.Visibility" Value="Collapsed"/>
                        <Setter Target="ChapterContainer.Visibility" Value="Collapsed"/>
                        <Setter Target="InlineVolumeHost.Visibility" Value="Collapsed"/>
                        <Setter Target="VolumeButton.Visibility" Value="Visible"/>
                        <Setter Target="MoreButton.Visibility" Value="Visible"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border x:Name="SeekPreviewCard" Canvas.ZIndex="20" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" Padding="8" CornerRadius="8" Background="{ThemeResource PlayerFallbackSurface}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="6"><Grid x:Name="SpriteViewport" Width="160" Height="90"><Grid.Clip><RectangleGeometry Rect="0,0,160,90"/></Grid.Clip><Canvas><Image x:Name="SpriteSheetImage" Stretch="Fill" Visibility="Collapsed"/></Canvas><TextBlock x:Name="SpriteStatus" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource PlayerForeground}" FontSize="12"/></Grid><TextBlock x:Name="SeekPreviewTime" HorizontalAlignment="Center" Foreground="{ThemeResource PlayerForeground}" FontSize="12" Typography.NumeralAlignment="Tabular"/></StackPanel>
        </Border>
        <ProgressRing x:Name="PlaybackBusyRing" Width="40" Height="40" IsActive="False" Visibility="Collapsed"
                      IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource PlayerForeground}" AutomationProperties.Name="正在加载视频"/>
        <TextBlock x:Name="PlaybackBusyText" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,78,0,0" Visibility="Collapsed" Foreground="{ThemeResource PlayerForeground}" FontSize="13" IsHitTestVisible="False"/>
        <Grid x:Name="Chrome">
            <!-- Native window behavior is owned
                 by the host; these buttons only raise requests. -->
            <Grid x:Name="TopBar" Height="72" VerticalAlignment="Top" Padding="12,10,12,10"
                  Background="{ThemeResource PlayerTopGradient}" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource PlayerButtonStyle}" Click="Close_Click"
                        AutomationProperties.Name="关闭视频并返回文件" ToolTipService.ToolTip="返回文件">
                    <local:ScreenboxVectorIcon IconName="ArrowLeft" Width="20" Height="20" />
                </Button>
                <Grid x:Name="TitleDragRegion" Grid.Column="1" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" Spacing="2" IsHitTestVisible="False">
                        <TextBlock x:Name="TitleText" TextTrimming="CharacterEllipsis" FontSize="20"
                                   FontWeight="SemiBold" Foreground="{ThemeResource PlayerForeground}" />
                        <TextBlock x:Name="SubtitleText" TextTrimming="CharacterEllipsis" FontSize="12"
                                   Foreground="{ThemeResource PlayerSecondary}" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="WindowButtons" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="MinimizeButton" Style="{StaticResource PlayerButtonStyle}" Click="Minimize_Click"
                            AutomationProperties.Name="最小化视频窗口" ToolTipService.ToolTip="最小化">
                        <local:ScreenboxVectorIcon IconName="Subtract" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="MaximizeButton" Style="{StaticResource PlayerButtonStyle}" Click="Maximize_Click"
                            AutomationProperties.Name="最大化视频窗口" ToolTipService.ToolTip="最大化">
                        <local:ScreenboxVectorIcon x:Name="MaximizeIcon" IconName="Square" Width="20" Height="20"/>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource PlayerButtonStyle}" Click="Close_Click"
                            AutomationProperties.Name="关闭视频窗口" ToolTipService.ToolTip="关闭视频">
                        <local:ScreenboxVectorIcon IconName="Dismiss" Width="20" Height="20"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid x:Name="BottomBar" VerticalAlignment="Bottom" Background="{ThemeResource PlayerBottomGradient}">
                <Grid Padding="12,8,12,12" RowSpacing="0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="12,0">
                        <Grid x:Name="ResumeToast" Visibility="Collapsed" MaxWidth="640" HorizontalAlignment="Center" ColumnSpacing="12" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResumeText" FontSize="14" Foreground="{ThemeResource PlayerForeground}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="ResumeActionButton" Grid.Column="1" Style="{StaticResource PlayerActionButtonStyle}" Click="ResumeAction_Click"/>
                            <Button Grid.Column="2" Width="32" Height="32" Style="{StaticResource PlayerButtonStyle}" Click="ResumeDismiss_Click"
                                    AutomationProperties.Name="关闭续播提示" ToolTipService.ToolTip="关闭提示">
                                <local:ScreenboxVectorIcon IconName="Dismiss" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ProgressSyncText" Visibility="Collapsed" Text="播放进度暂未同步" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource PlayerSecondary}" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
                        <InfoBar x:Name="Notice" HorizontalAlignment="Center" MaxWidth="480"
                                 IsOpen="False" IsClosable="True" Severity="Error" Closed="Notice_Closed" />
                        <!-- Actual file-byte evidence, separate from the seek/cache timeline.
                             This quiet row follows the existing BottomBar safe-area measurement. -->
                        <Grid x:Name="DownloadStatusRow" Visibility="Collapsed" ColumnSpacing="10" Margin="0,2,0,4"
                              AutomationProperties.LiveSetting="Off">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="DownloadStatusText" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{ThemeResource PlayerSecondary}"/>
                            <TextBlock x:Name="DownloadBytesText" Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"
                                       Foreground="{ThemeResource PlayerSecondary}"/>
                            <ProgressBar x:Name="DownloadByteProgress" Grid.Column="2" Width="64" Height="2" VerticalAlignment="Center"
                                         Minimum="0" Maximum="100" Foreground="{ThemeResource PlayerSecondary}"
                                         Background="{ThemeResource SliderTrackFill}" AutomationProperties.Name="下载接收字节进度"
                                         AutomationProperties.LiveSetting="Off"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="PreviewText" Grid.Row="1" Text="00:00" Visibility="Collapsed" Margin="12,0,0,0"
                               Foreground="{ThemeResource PlayerForeground}" Typography.NumeralAlignment="Tabular" FontSize="12" />
                    <!-- Screenbox SeekBar's composition: segmented progress under
                         a transparent native Slider; real cache data is a second layer. -->
                    <Grid Grid.Row="2" Margin="8,0">
                        <local:ScreenboxSeekSlider x:Name="SeekSlider" Minimum="0" Maximum="1"
                                SmallChange="5" LargeChange="10" Height="32" Style="{StaticResource DefaultSliderStyle}"
                                IsThumbToolTipEnabled="False" ValueChanged="Seek_ValueChanged" KeyUp="Seek_KeyUp" AutomationProperties.Name="播放进度">
                            <local:ScreenboxSeekSlider.Resources>
                                <SolidColorBrush x:Key="SliderTrackFill" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackFillPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackValueFill" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="Transparent"/>
                                <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent"/>
                            </local:ScreenboxSeekSlider.Resources>
                        </local:ScreenboxSeekSlider>
                    </Grid>
                    <Grid x:Name="TransportRow" Grid.Row="3" ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayerButtonStyle}" Click="Play_Click"
                                AutomationProperties.Name="暂停播放" ToolTipService.ToolTip="播放 / 暂停（Space）">
                            <local:ScreenboxVectorIcon x:Name="PlayIcon" IconName="Pause" Width="20" Height="20" />
                        </Button>
                        <Button x:Name="BackTenButton" Grid.Column="1" Style="{StaticResource PlayerButtonStyle}" Click="BackTen_Click"
                                AutomationProperties.Name="后退十秒" ToolTipService.ToolTip="后退十秒"><local:ScreenboxVectorIcon IconName="SkipBack10" Width="20" Height="20" /></Button>
                        <Button x:Name="ForwardTenButton" Grid.Column="2" Style="{StaticResource PlayerButtonStyle}" Click="ForwardTen_Click"
                                AutomationProperties.Name="前进十秒" ToolTipService.ToolTip="前进十秒"><local:ScreenboxVectorIcon IconName="SkipForward10" Width="20" Height="20" /></Button>
                        <Grid Grid.Column="3" ColumnSpacing="8" Margin="8,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TimeText" Text="00:00 / --:--" Foreground="{ThemeResource PlayerForeground}"
                                           FontSize="14" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="DownloadRateText" Visibility="Collapsed" FontSize="12" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource PlayerSecondary}"
                                           ToolTipService.ToolTip="上游网络预加载速度（MB/s = 1,000,000 字节/秒），不包含磁盘缓存命中" />
                            </StackPanel>
                            <Grid x:Name="ChapterContainer" Grid.Column="1">
                            <Button x:Name="ChapterButton" Width="Auto" MinWidth="0" MaxWidth="240" Padding="8,0"
                                    HorizontalAlignment="Left" Style="{StaticResource PlayerButtonStyle}" Visibility="Collapsed"
                                    Click="Chapter_Click" AutomationProperties.Name="选择章节">
                                <Grid ColumnSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ChapterTitle" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <local:ScreenboxVectorIcon Grid.Column="1" IconName="ChevronDown" Width="12" Height="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="Tools" Grid.Column="4" Orientation="Horizontal" Spacing="4">
                            <ContentControl x:Name="InlineVolumeHost" VerticalAlignment="Center" Margin="0,0,8,0" IsTabStop="False" />
                            <Button x:Name="VolumeButton" Style="{StaticResource PlayerButtonStyle}" Click="Volume_Click"
                                    AutomationProperties.Name="音量" ToolTipService.ToolTip="音量与静音"><local:ScreenboxVectorIcon x:Name="VolumeIcon" IconName="Speaker2" Width="20" Height="20" /></Button>
                            <StackPanel x:Name="AdaptiveTools" Orientation="Horizontal" Spacing="4">
                            <Button x:Name="ResolutionButton" Width="Auto" MinWidth="0" Padding="8,0" FontSize="12" Style="{StaticResource PlayerButtonStyle}"
                                    Visibility="Collapsed" Click="Resolution_Click" AutomationProperties.Name="源分辨率" ToolTipService.ToolTip="源分辨率">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock x:Name="ResolutionText" VerticalAlignment="Center"/>
                                    <local:ScreenboxVectorIcon IconName="ChevronDown" Width="12" Height="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AudioButton" Style="{StaticResource PlayerButtonStyle}" Click="Audio_Click"
                                    AutomationProperties.Name="选择音轨" ToolTipService.ToolTip="音轨"><local:ScreenboxVectorIcon IconName="MusicNote2" Width="20" Height="20" /></Button>
                            <Button x:Name="SubtitleButton" Style="{StaticResource PlayerButtonStyle}" Click="Subtitle_Click"
                                    AutomationProperties.Name="选择字幕" ToolTipService.ToolTip="字幕"><local:ScreenboxVectorIcon IconName="ClosedCaption" Width="20" Height="20" /></Button>
                            <Button x:Name="SubtitleStyleButton" Style="{StaticResource PlayerButtonStyle}" Click="SubtitleStyle_Click"
                                    ToolTipService.ToolTip="字幕样式" AutomationProperties.Name="字幕样式"><local:ScreenboxVectorIcon IconName="TextFontSize" Width="20" Height="20" /></Button>
                            <Button x:Name="SpeedButton" Width="48" Style="{StaticResource PlayerButtonStyle}" Content="1×"
                                    Click="Speed_Click" AutomationProperties.Name="播放速度" ToolTipService.ToolTip="播放速度" />
                            </StackPanel>
                            <Button x:Name="MoreButton" Style="{StaticResource PlayerButtonStyle}" Click="More_Click" Visibility="Collapsed"
                                    AutomationProperties.Name="更多播放选项" ToolTipService.ToolTip="更多播放选项"><local:ScreenboxVectorIcon IconName="MoreHorizontal" Width="20" Height="20"/></Button>
                            <Button x:Name="FullscreenButton" Style="{StaticResource PlayerButtonStyle}" Click="Fullscreen_Click"
                                    AutomationProperties.Name="全屏" ToolTipService.ToolTip="全屏（F11）"><local:ScreenboxVectorIcon x:Name="FullscreenIcon" IconName="FullScreenMaximize" Width="20" Height="20" /></Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
