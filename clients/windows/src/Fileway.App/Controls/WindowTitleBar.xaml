<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Fileway.App.Controls.WindowTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:playback="using:Fileway.App.Controls.Playback"
    Height="48" IsTabStop="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="TitleBarSurfaceBrush" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TitleBarSurfaceBrush" Color="Transparent" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="TitleBarSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Keep the SDK Button template, input and focus behavior. -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{ThemeResource TitleBarSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- The native owner uses exactly this rectangle for caption dragging. -->
        <Grid x:Name="DragSurface" Background="Transparent">
         <Grid.ColumnDefinitions><ColumnDefinition x:Name="BrandColumn" Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Grid x:Name="BrandSurface" Padding="16,0,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Width="24" Height="24" VerticalAlignment="Center" Stretch="Uniform"
                   Source="ms-appx:///Assets/Square44x44Logo.targetsize-48_altform-lightunplated.png"
                   IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="CaptionText" Grid.Column="1" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" IsHitTestVisible="False" />
         </Grid>
         <ContentPresenter x:Name="NavigationPresenter" Grid.Column="1" Visibility="Collapsed" Margin="0,0,12,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" />
        </Grid>
        <Button x:Name="MinimizeButton" Grid.Column="1" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" Loaded="CaptionButton_Loaded">
            <playback:ScreenboxVectorIcon IconName="Subtract" Width="20" Height="20" Foreground="{Binding Foreground, ElementName=MinimizeButton}" />
        </Button>
        <Button x:Name="MaximizeButton" Grid.Column="2" Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click" Loaded="CaptionButton_Loaded">
            <playback:ScreenboxVectorIcon x:Name="MaximizeIcon" IconName="Square" Width="20" Height="20" Foreground="{Binding Foreground, ElementName=MaximizeButton}" />
        </Button>
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CaptionButtonStyle}" Click="Close_Click" Loaded="CaptionButton_Loaded">
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Default">
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A62017" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="White" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush" />
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <playback:ScreenboxVectorIcon IconName="Dismiss" Width="20" Height="20" Foreground="{Binding Foreground, ElementName=CloseButton}" />
        </Button>
    </Grid>
</UserControl>
