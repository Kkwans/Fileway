<UserControl x:Class="Fileway.App.Controls.Collections.ResourceCollectionsControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Collections">
 <UserControl.Resources>
  <DataTemplate x:Key="GroupChoiceTemplate"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Label}"/></DataTemplate>
  <DataTemplate x:Key="TagColorTemplate"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="14" Height="14" Fill="{Binding Brush}" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
 <DataTemplate x:Key="CollectionTemplate" x:DataType="local:CollectionRow">
   <Grid Padding="10,8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ui:LucideIcon IconName="{x:Bind IconName}" Width="22" Height="22" VerticalAlignment="Center" Visibility="{x:Bind IconVisibility}"/>
    <Ellipse Width="12" Height="12" Fill="{x:Bind TagColorBrush}" Visibility="{x:Bind TagColorVisibility}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Spacing="3">
     <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
     <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Detail}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Detail}"/>
     <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind State}" TextWrapping="Wrap" Visibility="{x:Bind StateVisibility}"/>
    </StackPanel>
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Padding="20,12" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:FwPageHeader x:Name="CollectionsHeader" Title="收藏与标签" Subtitle="管理当前账号的收藏、分组与标签。">
   <ui:FwPageHeader.Actions>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新"><ui:LucideIcon IconName="arrows-clockwise" Width="18" Height="18"/></Button>
    <Button x:Name="AddFavoriteButton" Click="AddFavorite_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="收藏选中资源" AutomationProperties.Name="收藏选中资源"><ui:LucideIcon IconName="heart" Width="18" Height="18"/></Button>
    <Button x:Name="ResourceTagsButton" Click="ResourceTags_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="设置资源标签" AutomationProperties.Name="设置资源标签"><ui:LucideIcon IconName="tag" Width="18" Height="18"/></Button>
    <Button x:Name="OpenTagResourceButton" Click="OpenTagResource_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="打开资源" AutomationProperties.Name="打开资源"><ui:LucideIcon IconName="folder-open" Width="18" Height="18"/></Button>
    <Button x:Name="UnlinkButton" Click="Unlink_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="取消关联" AutomationProperties.Name="取消关联"><ui:LucideIcon IconName="x" Width="18" Height="18"/></Button>
    <Button x:Name="CollectionsMoreButton" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="更多" AutomationProperties.Name="更多收藏操作"><ui:LucideIcon IconName="dots-three" Width="18" Height="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="CreateGroupButton" Text="新建分组" Click="CreateGroup_Click"/><MenuFlyoutItem x:Name="CreateTagButton" Text="新建标签" Click="CreateTag_Click"/></MenuFlyout></Button.Flyout></Button>
    <Button Content="返回文件" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开收藏与标签，返回文件"/>
    </StackPanel>
   </ui:FwPageHeader.Actions>
  </ui:FwPageHeader>
  <Grid x:Name="ManagementSelection" Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ui:ChoiceBox x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed" AutomationProperties.Name="收藏或标签"><ComboBoxItem Content="收藏"/><ComboBoxItem Content="标签"/></ui:ChoiceBox>
   <Grid Grid.Column="1" HorizontalAlignment="Left" ColumnSpacing="4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ui:ChoiceBox x:Name="GroupBox" Width="192" ItemTemplate="{StaticResource GroupChoiceTemplate}" SelectionChanged="Group_Changed" AutomationProperties.Name="收藏分组"/>
    <Button x:Name="GroupMoreButton" Grid.Column="1" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="分组操作" AutomationProperties.Name="更多分组操作"><ui:LucideIcon IconName="dots-three" Width="18" Height="18"/><Button.Flyout><MenuFlyout><MenuFlyoutItem x:Name="EditGroupButton" Text="编辑当前分组" Click="EditGroup_Click"/><MenuFlyoutItem x:Name="RemoveGroupButton" Text="删除当前分组" Click="RemoveGroup_Click"/></MenuFlyout></Button.Flyout></Button>
   </Grid>
   <StackPanel x:Name="SelectionCommands" Grid.Column="2" Orientation="Horizontal" Spacing="4">
    <Button x:Name="OpenButton" Click="Open_Click" Style="{StaticResource FwTextIconButtonStyle}" AutomationProperties.Name="打开"><StackPanel Orientation="Horizontal" Spacing="6"><ui:LucideIcon IconName="folder-open" Width="16" Height="16"/><TextBlock Text="打开" FontSize="13"/></StackPanel></Button>
    <Button x:Name="EditButton" Click="Edit_Click" Style="{StaticResource FwTextIconButtonStyle}" AutomationProperties.Name="编辑"><StackPanel Orientation="Horizontal" Spacing="6"><ui:LucideIcon IconName="pencil-simple" Width="16" Height="16"/><TextBlock Text="编辑" FontSize="13"/></StackPanel></Button>
    <Button x:Name="RemoveButton" Click="Remove_Click" Style="{StaticResource FwTextIconButtonStyle}" AutomationProperties.Name="移除"><StackPanel Orientation="Horizontal" Spacing="6"><ui:LucideIcon IconName="trash" Width="16" Height="16"/><TextBlock Text="移除" FontSize="13"/></StackPanel></Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" RowSpacing="8"><Grid.RowDefinitions><RowDefinition x:Name="RecordsRow" Height="*"/><RowDefinition x:Name="TagResourcesRow" Height="0"/></Grid.RowDefinitions>
   <ListView x:Name="Records" ItemTemplate="{StaticResource CollectionTemplate}" SelectionMode="Single" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource FwListRecordItemStyle}" SelectionChanged="Record_Changed" DoubleTapped="Records_DoubleTapped" KeyDown="Records_KeyDown" AutomationProperties.Name="收藏或标签列表">
    <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="ContextOpen" Text="打开选中资源" Click="Open_Click"/><MenuFlyoutItem x:Name="ContextEdit" Text="编辑选中记录" Click="Edit_Click"/><MenuFlyoutItem x:Name="ContextRemove" Text="移除选中记录" Click="Remove_Click"/></MenuFlyout></ListView.ContextFlyout>
   </ListView>
   <ui:FwEmptyState x:Name="EmptyHost" IconName="heart" Title="暂无记录" Description="添加收藏或标签后会显示在这里。"/>
   <Grid x:Name="TagResourcesArea" Grid.Row="1" Visibility="Collapsed">
    <ListView x:Name="TagResources" ItemTemplate="{StaticResource CollectionTemplate}" SelectionMode="Single" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource FwListRecordItemStyle}" SelectionChanged="TagResource_Changed" DoubleTapped="TagResources_DoubleTapped" KeyDown="TagResources_KeyDown" AutomationProperties.Name="标签关联资源"/>
    <ui:FwEmptyState x:Name="TagEmptyHost" IconName="tag" Title="选择标签" Description="选择标签以查看关联资源。"/>
   </Grid>
  </Grid>
  <StackPanel x:Name="CollectionStatusHost" Grid.Row="3">
   <InfoBar x:Name="Status" IsOpen="False" IsClosable="True"/>
  </StackPanel>
 </Grid>
</UserControl>
