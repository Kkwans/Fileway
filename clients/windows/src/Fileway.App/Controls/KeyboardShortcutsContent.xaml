<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.KeyboardShortcutsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FwKeycapStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource FwSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource FwStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="BodyScroll" MaxHeight="440" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Groups" Spacing="14" MinWidth="360">
            <TextBlock Text="按下以下组合键快速操作。文本输入框保留系统编辑快捷键。" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource FwTextSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
