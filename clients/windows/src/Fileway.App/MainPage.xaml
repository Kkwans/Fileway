  <nasTasks:NasTasksControl x:Name="NasTasksPane" Visibility="Collapsed" AutomationProperties.AutomationId="NasTasksPane"/>
  <trash:TrashControl x:Name="TrashPane" Visibility="Collapsed" AutomationProperties.AutomationId="TrashPane"/>
  <transfers:TransferCenterControl x:Name="TransfersPanel" Visibility="Collapsed" AutomationProperties.AutomationId="TransfersPanel"/>
  <ContentControl x:Name="StorageToolsHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.AutomationId="StorageToolsHost"/>
  <server:LocalServerControl x:Name="LocalServerPane" Visibility="Collapsed" AutomationProperties.AutomationId="LocalServerPane"/>
  <collections:ResourceCollectionsControl x:Name="CollectionsPanel" Visibility="Collapsed" AutomationProperties.AutomationId="CollectionsPanel"/>
  <settings:SettingsControl x:Name="SettingsPane" Visibility="Collapsed" AutomationProperties.AutomationId="SettingsPane"/>
  <ContentControl x:Name="ServerUsersHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <Grid x:Name="ConnectionPanel" Background="Transparent" Visibility="Collapsed" SizeChanged="ConnectionPanel_SizeChanged" AutomationProperties.AutomationId="ConnectionPanel">
   <ScrollViewer x:Name="ConnectionFormScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="ConnectionFormScroller">
    <Grid x:Name="ConnectionFormGrid" MaxWidth="1120" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="56,24" ColumnSpacing="64">
     <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConnectionBrandColumn" Width="*" MinWidth="0"/><ColumnDefinition x:Name="ConnectionCardColumn" Width="440"/></Grid.ColumnDefinitions>
     <Grid x:Name="ConnectionBrandHost" VerticalAlignment="Center">
     <StackPanel x:Name="ConnectionBrand" Spacing="18" VerticalAlignment="Center" MaxWidth="440" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
       <Border Width="44" Height="44" CornerRadius="12" Background="{ThemeResource FwSurfaceRaisedBrush}" BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="1">
        <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="28" Height="28" Stretch="Uniform"/>
       </Border>
       <TextBlock Text="栖卷" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource FwTextPrimaryBrush}"/>
      </StackPanel>
      <TextBlock Text="连接你的文件空间" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource FwTextPrimaryBrush}"
                 AutomationProperties.AutomationId="ConnectionBrandTitle"/>
      <TextBlock Text="连接你自己的服务器，像本地磁盘一样浏览、预览和传输文件。" FontSize="14" LineHeight="22" TextWrapping="Wrap" Foreground="{ThemeResource FwTextSecondaryBrush}"/>
      <StackPanel Spacing="14" Margin="0,6,0,0">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ui:LucideIcon IconName="folder-open" Width="20" Height="20" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource FwTextPrimaryBrush}"/>
        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="像资源管理器一样浏览" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FwTextPrimaryBrush}"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="网格、详细与紧凑视图，支持多选、拖拽移动和批量操作。" TextWrapping="Wrap"/></StackPanel>
       </Grid>
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ui:LucideIcon IconName="eye" Width="20" Height="20" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource FwTextPrimaryBrush}"/>
        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="内置预览" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FwTextPrimaryBrush}"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="图片、文本、Markdown、压缩包和 PDF 无需先下载。" TextWrapping="Wrap"/></StackPanel>
       </Grid>
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ui:LucideIcon IconName="clock" Width="20" Height="20" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource FwTextPrimaryBrush}"/>
        <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="保持登录，随时回来" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource FwTextPrimaryBrush}"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="会话在本机加密保存，启动后自动恢复最近的文件空间。" TextWrapping="Wrap"/></StackPanel>
       </Grid>
      </StackPanel>
     </StackPanel>
     </Grid>
     <Border Grid.Column="1" Padding="26,22" CornerRadius="18" Background="{ThemeResource FwSurfaceBrush}" BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="1"
             VerticalAlignment="Center" AutomationProperties.AutomationId="ConnectionFormCard">
      <StackPanel Spacing="10" HorizontalAlignment="Stretch">
       <StackPanel Spacing="4">
        <TextBlock x:Name="ConnectionModeTitle" Text="新建连接" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource FwTextPrimaryBrush}"
                   AutomationProperties.AutomationId="ConnectionModeTitle"/>
        <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="连接成功后保存连接档案；保持登录可在下次启动时自动恢复。" TextWrapping="Wrap"/>
       </StackPanel>
       <Grid x:Name="SavedConnectionsPanel" ColumnSpacing="6" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ui:ChoiceBox x:Name="SavedConnectionBox" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="SavedConnection_Changed" AutomationProperties.Name="已保存连接"/>
        <Button x:Name="NewConnectionButton" Grid.Column="1" Content="新建" Click="NewConnection_Click" IsEnabled="False" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="新建连接"/>
        <Button x:Name="ForgetSavedButton" Grid.Column="2" Content="忘记" Click="ForgetSaved_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="忘记连接"/>
       </Grid>
       <StackPanel Spacing="6">
        <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="服务器地址"/>
        <TextBox x:Name="ServerBox" Height="36" PlaceholderText="https://你的服务器地址" TextChanged="ConnectionDraftChanged" InputScope="Url"
                 KeyDown="ConnectionField_KeyDown" Style="{StaticResource FwTextBoxStyle}" AutomationProperties.Name="服务器地址" AutomationProperties.AutomationId="ServerBox"/>
       </StackPanel>
       <StackPanel Spacing="6">
        <TextBlock Text="连接名称（可选）" Style="{StaticResource FwCaptionTextStyle}"/>
        <TextBox x:Name="ConnectionNameBox" Height="36" PlaceholderText="家里的文件空间" TextChanged="ConnectionDraftChanged"
                 KeyDown="ConnectionField_KeyDown" Style="{StaticResource FwTextBoxStyle}" AutomationProperties.Name="连接名称，可选" AutomationProperties.AutomationId="ConnectionNameBox"/>
       </StackPanel>
       <StackPanel Spacing="6">
        <Grid ColumnSpacing="12">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="6">
          <TextBlock Text="连接方式" Style="{StaticResource FwCaptionTextStyle}"/>
          <ui:ChoiceBox x:Name="ConnectionNetworkBox" Height="36" SelectedIndex="0" HorizontalAlignment="Stretch"
                        SelectionChanged="ConnectionNetwork_Changed" AutomationProperties.Name="连接方式" AutomationProperties.AutomationId="ConnectionNetworkMode">
           <ComboBoxItem Content="系统网络（直接）"/><ComboBoxItem Content="系统 Tailscale"/><ComboBoxItem Content="内嵌 Tailscale"/>
          </ui:ChoiceBox>
         </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6"><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="认证方式"/><ui:ChoiceBox x:Name="AuthenticationBox" Height="36" SelectedIndex="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" SelectionChanged="Authentication_Changed" AutomationProperties.Name="认证方式"><ComboBoxItem Content="账号密码"/><ComboBoxItem Content="无需认证"/></ui:ChoiceBox></StackPanel>
        </Grid>
        <TextBlock x:Name="SystemTailnetHint" Text="先在 Windows 的 Tailscale 应用中登录，再输入 Tailnet 内的服务器地址。"
                   Visibility="Collapsed" Style="{StaticResource FwCaptionTextStyle}" TextWrapping="Wrap"/>
        <Border x:Name="EmbeddedTailnetCard" Visibility="Collapsed" Style="{StaticResource FwFormCardStyle}" Padding="12">
         <StackPanel Spacing="6">
         <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Spacing="3" VerticalAlignment="Center">
           <TextBlock x:Name="TailnetStateText" FontWeight="SemiBold" TextWrapping="Wrap"
                      AutomationProperties.AutomationId="EmbeddedTailnetState" AutomationProperties.LiveSetting="Polite"/>
           <TextBlock x:Name="TailnetHintText" Style="{StaticResource FwCaptionTextStyle}" TextWrapping="Wrap"
                      Visibility="Collapsed" AutomationProperties.AutomationId="EmbeddedTailnetHint"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
           <ProgressRing x:Name="TailnetProgressRing" Width="18" Height="18" Visibility="Collapsed"
                         AutomationProperties.AccessibilityView="Raw"/>
           <Button x:Name="TailnetLogoutButton" Content="注销设备…" Click="LogoutTailnet_Click" Visibility="Collapsed"
                   Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.AutomationId="LogoutEmbeddedTailnet"/>
           <Button x:Name="TailnetStopButton" Content="停止" Click="StopTailnet_Click" Visibility="Collapsed"
                   Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.AutomationId="StopEmbeddedTailnet"/>
           <Button x:Name="TailnetAuthorizeButton" Content="登录授权" Click="AuthorizeTailnet_Click" Visibility="Collapsed"
                   Style="{StaticResource FwPrimaryButtonStyle}" AutomationProperties.AutomationId="AuthorizeEmbeddedTailnet"/>
           <Button x:Name="TailnetStartButton" Content="启动" Click="StartTailnet_Click" Visibility="Collapsed"
                   Style="{StaticResource FwPrimaryButtonStyle}" AutomationProperties.AutomationId="StartEmbeddedTailnet"/>
           <Button x:Name="TailnetReadButton" Content="重新读取" Click="ReadTailnet_Click" Visibility="Collapsed"
                   Style="{StaticResource FwPrimaryButtonStyle}" AutomationProperties.AutomationId="ReadEmbeddedTailnet"/>
          </StackPanel>
         </Grid>
          <TextBlock x:Name="TailnetAddressText" Style="{StaticResource FwCaptionTextStyle}"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed"/>
          <TextBlock x:Name="TailnetFeedbackText" Style="{StaticResource FwDangerTextStyle}"
                     TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="EmbeddedTailnetFeedback"/>
         </StackPanel>
        </Border>
       </StackPanel>
       <Grid x:Name="CredentialFields" ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="6">
         <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="用户名"/>
         <TextBox x:Name="UsernameBox" Height="36" PlaceholderText="服务器用户名" TextChanged="ConnectionDraftChanged"
                  KeyDown="ConnectionField_KeyDown" Style="{StaticResource FwTextBoxStyle}" AutomationProperties.Name="用户名" AutomationProperties.AutomationId="UsernameBox"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6">
         <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="密码"/>
         <PasswordBox x:Name="PasswordBox" Height="36" PlaceholderText="输入密码" PasswordRevealMode="Peek" PasswordChanged="ConnectionDraftChanged"
                      KeyDown="ConnectionField_KeyDown" Style="{StaticResource FwPasswordBoxStyle}" AutomationProperties.Name="密码" AutomationProperties.AutomationId="PasswordBox"/>
        </StackPanel>
       </Grid>
       <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <CheckBox x:Name="KeepSignedInBox" Content="保持登录" IsChecked="True" VerticalAlignment="Center"
                  Checked="ConnectionDraftChanged" Unchecked="ConnectionDraftChanged" AutomationProperties.AutomationId="KeepSignedInBox"/>
        <TextBlock Grid.Column="1" Style="{StaticResource FwCaptionTextStyle}" x:Name="RetentionDescription"
                   Text="加密保存密码和会话，共用电脑请取消。" VerticalAlignment="Center" TextWrapping="Wrap"/>
       </Grid>
       <InfoBar x:Name="LoginNotice" IsOpen="False" Visibility="Collapsed" IsClosable="True" Severity="Informational"
                AutomationProperties.AutomationId="LoginNotice"/>
       <Border Height="1" Margin="0,2,0,0" Style="{StaticResource FwDividerStyle}"/>
       <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
         <Button x:Name="DismissConnection" Content="返回" Visibility="Collapsed" Click="DismissConnection_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="返回文件"/>
         <Button x:Name="CancelConnectionButton" Content="取消连接" Visibility="Collapsed" Click="CancelConnection_Click" Style="{StaticResource FwSecondaryButtonStyle}"/>
         <Button x:Name="LoginErrorDetailsButton" Content="错误详情" Visibility="Collapsed" Click="NoticeErrorDetails_Click"
                 Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.AutomationId="LoginErrorDetailsButton"/>
         <Button x:Name="LocalServerFromConnectionButton" Content="部署本地服务端" Click="LocalServer_Click"
                 Style="{StaticResource FwTextIconButtonStyle}" AutomationProperties.Name="打开本地服务端页面"/>
        </StackPanel>
        <Button Grid.Column="1" x:Name="ConnectButton" Content="连接并浏览" Style="{StaticResource FwPrimaryButtonStyle}"
                Click="Connect_Click" IsEnabled="False" AutomationProperties.AutomationId="ConnectButton"/>
       </Grid>
      </StackPanel>
     </Border>
    </Grid>
   </ScrollViewer>
  </Grid>
   </Grid>
   <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Visibility="Collapsed">
    <InfoBar.ActionButton><Button x:Name="OperationActionButton" Content="核实结果" Visibility="Collapsed" Click="OperationAction_Click" Style="{StaticResource FwSecondaryButtonStyle}" Height="28" MinHeight="28" Padding="8,0"/></InfoBar.ActionButton>
    <InfoBar.Content><Button x:Name="NoticeErrorDetailsButton" Content="错误详情" Visibility="Collapsed" Click="NoticeErrorDetails_Click" Style="{StaticResource FwTextIconButtonStyle}"/></InfoBar.Content>
   </InfoBar>
   <InfoBar x:Name="ReceiptWarning" Grid.Row="2" IsOpen="False" IsClosable="True" Severity="Warning" Title="本机操作记录提示" Visibility="Collapsed"/>
   <InfoBar x:Name="UploadNotice" Grid.Row="3" IsOpen="False" IsClosable="True" Title="文件上传" Visibility="Collapsed">
    <InfoBar.ActionButton>
     <Button x:Name="UploadDetailsButton" Click="UploadDetails_Click" Style="{StaticResource TransferNoticeActionStyle}"
             AutomationProperties.AutomationId="UploadNoticeAction" AutomationProperties.Name="上传详情">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <TextBlock x:Name="UploadNoticeActionText" Text="上传详情" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <ui:LucideIcon IconName="arrow-left" Width="14" Height="14" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,0.5">
        <ui:LucideIcon.RenderTransform><RotateTransform Angle="180"/></ui:LucideIcon.RenderTransform>
       </ui:LucideIcon>
      </StackPanel>
     </Button>
    </InfoBar.ActionButton>
   </InfoBar>
   <InfoBar x:Name="DownloadNotice" Grid.Row="0" IsOpen="False" IsClosable="True" Visibility="Collapsed"
            AutomationProperties.AutomationId="DownloadNotice">
    <InfoBar.ActionButton>
     <Button x:Name="DownloadDetailsButton" Click="DownloadDetails_Click" Style="{StaticResource TransferNoticeActionStyle}"
             AutomationProperties.AutomationId="DownloadNoticeAction" AutomationProperties.Name="下载详情" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Spacing="6">
       <TextBlock x:Name="DownloadNoticeActionText" Text="下载详情" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <ui:LucideIcon IconName="arrow-left" Width="14" Height="14" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5,0.5">
        <ui:LucideIcon.RenderTransform><RotateTransform Angle="180"/></ui:LucideIcon.RenderTransform>
       </ui:LucideIcon>
      </StackPanel>
     </Button>
    </InfoBar.ActionButton>
   </InfoBar>
   </Grid>
   </Border>
   <Grid x:Name="StartupPanel" Grid.ColumnSpan="2" Grid.RowSpan="2" Canvas.ZIndex="200" Background="{ThemeResource FileContentSurfaceBrush}" AutomationProperties.Name="正在准备连接">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><ProgressRing IsActive="True" Width="32" Height="32"/><TextBlock Text="正在准备文件空间…" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
 </Grid>
</Page>
