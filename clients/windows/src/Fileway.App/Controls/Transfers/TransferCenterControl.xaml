<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Transfers.TransferCenterControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Fileway.App.Controls.Transfers">
 <Grid Padding="20,12,20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="传输中心" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ScopeText" Text="当前账号的上传与下载" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
   <Button Grid.Column="1" Content="返回文件" VerticalAlignment="Center" Click="Close_Click" AutomationProperties.Name="离开传输中心，返回文件"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="UploadsTab" Content="上传" Width="96" IsChecked="True" Click="Uploads_Click" AutomationProperties.Name="上传记录"/><ToggleButton x:Name="DownloadsTab" Content="下载" Width="96" Click="Downloads_Click" AutomationProperties.Name="下载记录"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="HistoryLoadingRing" Width="20" Height="20" IsActive="False" AutomationProperties.Name="正在加载传输记录"/><Button x:Name="RefreshButton" Click="Refresh_Click" Width="32" Height="32" Padding="0" AutomationProperties.Name="刷新当前传输记录" ToolTipService.ToolTip="刷新记录"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="8"><TextBlock x:Name="HintText" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><InfoBar x:Name="LoadError" IsOpen="False" IsClosable="False" Severity="Warning" Title="记录未能加载"><InfoBar.ActionButton><Button Content="重试" Click="More_Click"/></InfoBar.ActionButton></InfoBar></StackPanel>
  <Grid Grid.Row="3">
   <ListView x:Name="Records" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Record_Click" KeyDown="Records_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="传输记录，选择一项查看详情">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="local:TransferCenterRow">
     <Grid Padding="14,12" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
      <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.AccessibilityView="Raw"/>
      <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/><TextBlock Text="{x:Bind Stage, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
       <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" Height="4" AutomationProperties.Name="{x:Bind ProgressName}"/>
       <TextBlock Text="{x:Bind Bytes, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind Destination, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Destination, Mode=OneWay}"/>
      </StackPanel><FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AccessibilityView="Raw"/>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
    <ListView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ListView.ItemContainerTransitions>
   </ListView>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Spacing="12" Margin="12"><FontIcon Glyph="&#xE895;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="EmptyTitle" Text="暂无传输记录" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LoadedText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="MoreButton" Grid.Column="1" Content="加载更多" Click="More_Click" Visibility="Collapsed"/></Grid>
 </Grid>
</UserControl>
