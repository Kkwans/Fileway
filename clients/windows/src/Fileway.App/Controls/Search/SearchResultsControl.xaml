<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Search.SearchResultsControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:search="using:Fileway.App.Controls.Search">
 <Grid Padding="20,12,20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged" KeyDown="Panel_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <ui:FwPageHeader x:Name="SearchHeader" Title="搜索文件" Subtitle="按名称搜索当前目录及子目录">
   <ui:FwPageHeader.Actions>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="OpenSelectedButton" Content="打开" IsEnabled="False" Click="Open_Click" Style="{StaticResource FwSecondaryButtonStyle}" ToolTipService.ToolTip="核对并打开选中结果 (Enter)" AutomationProperties.Name="打开选中的搜索结果"/>
     <Button Content="返回文件" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开搜索，返回文件"/>
    </StackPanel>
   </ui:FwPageHeader.Actions>
  </ui:FwPageHeader>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="QueryBox" MinWidth="120" Height="36" MaxLength="8192" PlaceholderText="输入文件名或搜索条件" TextChanged="Query_Changed" KeyDown="Query_KeyDown" Style="{StaticResource FwTextBoxStyle}" AutomationProperties.Name="服务器搜索条件，按 Enter 开始搜索"/>
   <ui:ChoiceBox x:Name="ScopeBox" Grid.Column="1" Width="120" SelectedIndex="1" SelectionChanged="Scope_Changed" AutomationProperties.Name="服务器搜索范围"><ComboBoxItem Content="当前目录"/><ComboBoxItem Content="含子目录"/></ui:ChoiceBox>
   <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Height="36" Click="Search_Click" IsEnabled="False" Style="{StaticResource FwPrimaryButtonStyle}" AutomationProperties.Name="开始服务器搜索" ToolTipService.ToolTip="在服务器搜索指定范围 (Enter)"/>
  </Grid>
  <Grid Grid.Row="2">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="SearchSummaryBar" Visibility="Collapsed" Margin="0,0,0,8" ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SearchSubmittedSummary" Style="{StaticResource FwCaptionTextStyle}" VerticalAlignment="Center"
               TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="SearchSubmittedSummary"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <TextBlock x:Name="SearchDraftHint" Visibility="Collapsed" Style="{StaticResource FwCaptionTextStyle}" VerticalAlignment="Center"
                Text="条件或范围已修改，搜索后生效。" AutomationProperties.AutomationId="SearchDraftHint" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="SearchCount" Style="{StaticResource FwCaptionTextStyle}" TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.AutomationId="SearchCount"/>
     <StackPanel x:Name="SearchActions" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <ProgressRing x:Name="SearchActivityRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center" AutomationProperties.Name="搜索活动"/>
      <TextBlock x:Name="SearchActivityText" Style="{StaticResource FwCaptionTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="CancelSearchButton" Content="取消" Click="Cancel_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="取消搜索或资源核对，保留已收到的结果"/>
     </StackPanel>
     <Button x:Name="RetrySearchButton" Content="重新搜索" Visibility="Collapsed" Click="Retry_Click" Style="{StaticResource FwSecondaryButtonStyle}"
             ToolTipService.ToolTip="重新执行已提交的搜索，保留当前输入 (F5)" AutomationProperties.Name="重新执行上次搜索"/>
    </StackPanel>
   </Grid>
   <InfoBar x:Name="SearchNotice" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,8" IsOpen="False" IsClosable="False" Severity="Informational"/>
   <Grid x:Name="SearchHeaders" Grid.Row="2" Padding="10,0,10,6" ColumnSpacing="12" MinHeight="24">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="名称" Margin="40,0,0,0"/>
    <TextBlock Style="{StaticResource FwCaptionTextStyle}" Grid.Column="1" Text="大小/类型 · 修改时间" HorizontalAlignment="Right"/>
   </Grid>
   <ListView x:Name="SearchRecords" Grid.Row="3" SelectionMode="Single" SelectionChanged="Record_Changed" DoubleTapped="Records_DoubleTapped" PreviewKeyDown="Records_PreviewKeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="服务器搜索结果，选中后按 Enter 打开">
    <ListView.ItemContainerStyle>
     <Style TargetType="ListViewItem" BasedOn="{StaticResource FwListRecordItemStyle}">
      <Setter Property="MinHeight" Value="64"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
     </Style>
    </ListView.ItemContainerStyle>
    <ListView.ItemTemplate>
     <DataTemplate x:DataType="search:SearchResultRow">
      <ui:FwResourceRow IconName="{x:Bind IconName}" Title="{x:Bind Name}" Detail="{x:Bind DisplayDirectory}"
                        DetailToolTip="{x:Bind DisplayPath}" Hint="{x:Bind IdentityHint}" Summary="{x:Bind Summary}"
                        AutomationProperties.Name="{x:Bind AccessibleName}" AutomationProperties.HelpText="{x:Bind DisplayPath}"/>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <ui:FwEmptyState x:Name="SearchEmptyState" Grid.Row="2" Grid.RowSpan="2" IconName="magnifying-glass" Title="搜索服务器文件" Description="输入条件并选择范围，然后开始搜索。"/>
  </Grid>
 </Grid>
</UserControl>
