<?xml version="1.0" encoding="utf-8"?>
<!-- Structural port of Screenbox 6870eb0 Controls/PlaybackSpeedControl.xaml.
     Fileway binding, precise input and 0.125–5 range are modifications. GPL-3.0. -->
<UserControl x:Class="Fileway.App.Controls.Playback.ScreenboxSpeedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Playback" RequestedTheme="Dark">
    <Grid Width="320" Padding="16,0,16,16" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid MinHeight="48" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="播放速度" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="ConfirmedRate" Grid.Row="1" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Text="1×"/>
        <!-- Upstream repeat-button + slider interaction, with native RangeValue UIA. -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
            <RepeatButton MinWidth="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0" Click="Decrease_Click" AutomationProperties.Name="降低播放速度"><local:ScreenboxVectorIcon IconName="Subtract" Width="20" Height="20"/></RepeatButton>
            <Slider x:Name="RateSlider" Grid.Column="1" Minimum="0.125" Maximum="5" SmallChange="0.125" StepFrequency="0.125" IsThumbToolTipEnabled="False" VerticalAlignment="Center" ValueChanged="RateSlider_ValueChanged" AutomationProperties.Name="播放速度"/>
            <RepeatButton Grid.Column="2" MinWidth="48" Height="48" Padding="0" Background="Transparent" BorderThickness="0" Click="Increase_Click" AutomationProperties.Name="提高播放速度"><local:ScreenboxVectorIcon IconName="Add" Width="20" Height="20"/></RepeatButton>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <ToggleButton x:Name="Rate050" Content="0.5×" Tag="0.5" Click="Preset_Click" Padding="3,6" MinHeight="40" CornerRadius="16" HorizontalAlignment="Stretch"/>
            <ToggleButton x:Name="Rate075" Grid.Column="1" Content="0.75×" Tag="0.75" Click="Preset_Click" Padding="3,6" MinHeight="40" CornerRadius="16" HorizontalAlignment="Stretch"/>
            <ToggleButton x:Name="Rate100" Grid.Column="2" Content="1×" Tag="1" Click="Preset_Click" Padding="3,6" MinHeight="40" CornerRadius="16" HorizontalAlignment="Stretch"/>
            <ToggleButton x:Name="Rate150" Grid.Column="3" Content="1.5×" Tag="1.5" Click="Preset_Click" Padding="3,6" MinHeight="40" CornerRadius="16" HorizontalAlignment="Stretch"/>
            <ToggleButton x:Name="Rate200" Grid.Column="4" Content="2×" Tag="2" Click="Preset_Click" Padding="3,6" MinHeight="40" CornerRadius="16" HorizontalAlignment="Stretch"/>
        </Grid>
        <Grid Grid.Row="4" ColumnSpacing="8" Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <NumberBox x:Name="PreciseRate" Header="精确倍速 · 0.125–5" Minimum="0.125" Maximum="5" SmallChange="0.125" SpinButtonPlacementMode="Compact" AutomationProperties.Name="精确播放速度"/>
            <Button Grid.Column="1" Content="设置" VerticalAlignment="Bottom" MinHeight="40" Click="Precise_Click" AutomationProperties.Name="设置精确播放速度"/>
        </Grid>
    </Grid>
</UserControl>
