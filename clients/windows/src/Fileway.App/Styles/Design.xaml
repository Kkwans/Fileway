      <SolidColorBrush x:Key="FwStrokeStrongBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="FwTextPrimaryBrush" Color="#FFF4F6F8" />
      <SolidColorBrush x:Key="FwTextSecondaryBrush" Color="#FFA8AEB8" />
      <SolidColorBrush x:Key="FwTextTertiaryBrush" Color="#FF757C87" />
      <SolidColorBrush x:Key="FwScrimTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="FwScrimMutedBrush" Color="#FFC9CED6" />
      <SolidColorBrush x:Key="FwDangerBrush" Color="#FFFF6B6B" />
