<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Transfers.TransferCenterControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Fileway.App.Controls.Transfers">
 <Grid Padding="20,12,20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:FwPageHeader x:Name="TransferHeader" Title="传输中心" Subtitle="当前账号的上传与下载">
   <ui:FwPageHeader.Actions>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ToggleButton x:Name="DownloadsTab" Content="下载" Width="76" IsChecked="True" Click="Downloads_Click" Style="{StaticResource FwSegmentedChoiceStyle}" HorizontalContentAlignment="Center" AutomationProperties.Name="下载记录"/><ToggleButton x:Name="UploadsTab" Content="上传" Width="76" Click="Uploads_Click" Style="{StaticResource FwSegmentedChoiceStyle}" HorizontalContentAlignment="Center" AutomationProperties.Name="上传记录"/><ProgressRing x:Name="HistoryLoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="正在加载传输记录"/><Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" AutomationProperties.Name="刷新当前传输记录" ToolTipService.ToolTip="刷新记录"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/></Button><Button Content="返回文件" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开传输中心，返回文件"/></StackPanel>
   </ui:FwPageHeader.Actions>
  </ui:FwPageHeader>
  <StackPanel x:Name="HistoryFeedback" Grid.Row="1" Spacing="8"><TextBlock Style="{StaticResource FwCaptionTextStyle}" x:Name="HintText" Visibility="Collapsed" TextWrapping="Wrap"/><InfoBar x:Name="LoadError" IsOpen="False" IsClosable="True" Severity="Warning" Title="记录未能加载"><InfoBar.ActionButton><Button Content="重试" Click="More_Click" Style="{StaticResource FwSecondaryButtonStyle}"/></InfoBar.ActionButton></InfoBar></StackPanel>
  <Grid Grid.Row="2" Margin="0,16,0,0">
   <ListView x:Name="Records" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Record_Click" KeyDown="Records_KeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="传输记录，选择一项查看详情" ItemContainerStyle="{StaticResource FwListRecordItemStyle}">
    <ListView.ItemTemplate><DataTemplate x:DataType="local:TransferCenterRow">
     <Grid AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
      <Grid Visibility="{x:Bind HeaderVisibility}" Padding="16,14" ColumnSpacing="14">
       <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource FwSelectionBrush}" VerticalAlignment="Top"><ui:LucideIcon IconName="folder" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" Spacing="8">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Grid.Column="1" Text="{x:Bind Stage, Mode=OneWay}" Margin="12,0,0,0"/></Grid>
        <Border Height="6" CornerRadius="3" Background="{ThemeResource FwStrokeBrush}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
         <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" Height="4" VerticalAlignment="Center" Background="Transparent" CornerRadius="2" AutomationProperties.Name="{x:Bind ProgressName}"/>
        </Border>
        <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Bytes, Mode=OneWay}" TextWrapping="Wrap"/>
       </StackPanel>
      </Grid>
      <Grid Visibility="{x:Bind DetailVisibility}" Padding="16,14" ColumnSpacing="14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ui:LucideIcon IconName="{x:Bind IconName}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,0,0"/>
      <StackPanel Grid.Column="1" Spacing="8">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Grid.Column="1" Text="{x:Bind Stage, Mode=OneWay}" Margin="12,0,0,0"/></Grid>
       <Border Height="6" CornerRadius="3" Background="{ThemeResource FwStrokeBrush}" Visibility="{x:Bind ProgressVisibility, Mode=OneWay}">
        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" Height="4" VerticalAlignment="Center" Background="Transparent" CornerRadius="2" AutomationProperties.Name="{x:Bind ProgressName, Mode=OneWay}"/>
       </Border>
       <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="{x:Bind Bytes, Mode=OneWay}" Visibility="{x:Bind BytesVisibility, Mode=OneWay}"/>
       <TextBlock Text="{x:Bind Metrics, Mode=OneWay}" Visibility="{x:Bind MetricsVisibility, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Typography.NumeralAlignment="Tabular"/>
       <TextBlock Text="{x:Bind Destination, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorTertiaryBrush}" ToolTipService.ToolTip="{x:Bind Destination, Mode=OneWay}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="{x:Bind ActionsVisibility}">
       <Button Width="32" Height="32" Padding="0" Style="{StaticResource SubtleButtonStyle}" Click="Pause_Click" Visibility="{x:Bind PauseVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanTogglePause, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind PauseLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind PauseLabel, Mode=OneWay}"><ui:LucideIcon IconName="{x:Bind PauseIcon, Mode=OneWay}" Width="20" Height="20"/></Button>
       <Button Width="32" Height="32" Padding="0" Style="{StaticResource SubtleButtonStyle}" Click="Remove_Click" IsEnabled="{x:Bind CanRemove, Mode=OneWay}" ToolTipService.ToolTip="删除任务" AutomationProperties.Name="删除任务"><ui:LucideIcon IconName="trash" Width="20" Height="20"/></Button>
      </StackPanel>
      </Grid>
     </Grid>
    </DataTemplate></ListView.ItemTemplate>
    <ListView.ItemContainerTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></ListView.ItemContainerTransitions>
   </ListView>
   <ui:FwEmptyState x:Name="EmptyState" IconName="download-simple" Title="暂无传输记录"/>
  </Grid>
  <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FwCaptionTextStyle}" x:Name="LoadedText" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="MoreButton" Grid.Column="1" Content="加载更多" Click="More_Click" Visibility="Collapsed" Style="{StaticResource FwSecondaryButtonStyle}"/></Grid>
 </Grid>
</UserControl>
