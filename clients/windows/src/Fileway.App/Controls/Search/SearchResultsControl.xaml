<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Controls.Search.SearchResultsControl" xmlns:ui="using:Fileway.App.Controls"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:search="using:Fileway.App.Controls.Search">
 <Grid Padding="20,12,20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged" KeyDown="Panel_KeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Spacing="4"><TextBlock Text="搜索文件" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="按名称搜索当前目录及子目录" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="ConfirmedQueryText" Visibility="Collapsed" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   <Button Grid.Column="1" Content="返回文件" VerticalAlignment="Center" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开搜索，返回文件"/>
  </Grid>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox x:Name="QueryBox" MinWidth="120" Height="36" MaxLength="8192" PlaceholderText="输入文件名或搜索条件" TextChanged="Query_Changed" KeyDown="Query_KeyDown" Style="{StaticResource FwTextBoxStyle}" AutomationProperties.Name="服务器搜索条件，按 Enter 开始搜索"/>
   <ui:ChoiceBox x:Name="ScopeBox" Grid.Column="1" Width="120" SelectedIndex="1" SelectionChanged="Scope_Changed" AutomationProperties.Name="服务器搜索范围"><ComboBoxItem Content="当前目录"/><ComboBoxItem Content="含子目录"/></ui:ChoiceBox>
   <Button x:Name="SearchButton" Grid.Column="2" Content="搜索" Height="36" Click="Search_Click" IsEnabled="False" Style="{StaticResource FwPrimaryButtonStyle}" AutomationProperties.Name="开始服务器搜索" ToolTipService.ToolTip="在服务器搜索指定范围 (Enter)"/>
  </Grid>
  <Grid Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="OpenSelectedButton" Content="打开" IsEnabled="False" Click="Open_Click" Style="{StaticResource FwSecondaryButtonStyle}" ToolTipService.ToolTip="核对并打开选中结果 (Enter)" AutomationProperties.Name="打开选中的搜索结果"/><Button x:Name="CancelSearchButton" Content="取消" Visibility="Collapsed" Click="Cancel_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="取消搜索或资源核对，保留已收到的结果"/><Button x:Name="RetrySearchButton" Content="重新搜索" Visibility="Collapsed" Click="Retry_Click" Style="{StaticResource FwSecondaryButtonStyle}" ToolTipService.ToolTip="重新执行上次确认的搜索条件和范围 (F5)" AutomationProperties.Name="重新执行上次搜索"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ProgressRing x:Name="SearchActivityRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="搜索活动"/><TextBlock x:Name="SearchActivityText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid>
  <InfoBar x:Name="SearchNotice" Grid.Row="3" IsOpen="False" IsClosable="False" Severity="Informational"/>
  <Grid Grid.Row="4">
   <ListView x:Name="SearchRecords" SelectionMode="Single" SelectionChanged="Record_Changed" DoubleTapped="Records_DoubleTapped" PreviewKeyDown="Records_PreviewKeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="服务器搜索结果，选中后按 Enter 打开">
    <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="4,0"/><Setter Property="MinHeight" Value="64"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="4"/></Style></ListView.ItemContainerStyle>
    <ListView.ItemTemplate><DataTemplate x:DataType="search:SearchResultRow"><Grid Padding="8,8" ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ui:LucideIcon IconName="{x:Bind IconName}" Width="22" Height="22" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/><TextBlock Text="{x:Bind DisplayPath}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind DisplayPath}"/><TextBlock Text="{x:Bind Summary}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind IdentityHint}" Visibility="{x:Bind IdentityVisibility}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    </Grid></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel x:Name="SearchEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Spacing="14" Margin="12"><Border Width="72" Height="72" CornerRadius="20" HorizontalAlignment="Center" Background="{ThemeResource FwSurfaceBrush}" BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="1"><ui:LucideIcon IconName="magnifying-glass" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource FwTextSecondaryBrush}"/></Border><TextBlock x:Name="SearchEmptyTitle" Text="搜索服务器文件" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="{ThemeResource FwTextPrimaryBrush}"/><TextBlock x:Name="SearchEmptyText" Text="输入条件并选择范围，然后开始搜索。" FontSize="13" LineHeight="20" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource FwTextSecondaryBrush}"/></StackPanel>
  </Grid>
  <TextBlock x:Name="SearchCount" Grid.Row="5" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
