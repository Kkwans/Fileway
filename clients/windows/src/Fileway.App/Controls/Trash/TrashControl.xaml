<UserControl x:Class="Fileway.App.Controls.Trash.TrashControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Trash" xmlns:ui="using:Fileway.App.Controls" KeyDown="Panel_KeyDown">
 <Grid Padding="20,12" RowSpacing="12" SizeChanged="Panel_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ui:FwPageHeader Title="回收站" Subtitle="恢复或彻底删除已删除的项目。">
   <ui:FwPageHeader.Actions>
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/>
     <Button x:Name="RestoreButton" Content="恢复" Click="Restore_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="恢复所选项目"/>
     <Button x:Name="PermanentDeleteButton" Content="永久删除…" Click="Delete_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="永久删除所选项目" AutomationProperties.AutomationId="TrashPermanentDelete" ToolTipService.ToolTip="永久删除所选项目 (Delete)"/>
     <Button x:Name="RefreshButton" Click="Refresh_Click" Style="{StaticResource FwIconButtonStyle}" Width="36" Height="36" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新回收站"><ui:LucideIcon IconName="arrows-clockwise" Width="18" Height="18"/></Button>
     <Button Content="返回文件" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="离开回收站，返回文件"/>
    </StackPanel>
   </ui:FwPageHeader.Actions>
  </ui:FwPageHeader>
  <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid x:Name="HeaderRow" Padding="10,4,10,6" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="名称" Margin="40,0,0,0"/><TextBlock Style="{StaticResource FwCaptionTextStyle}" Grid.Column="1" Text="大小 · 删除时间" HorizontalAlignment="Right"/></Grid>
   <ListView x:Name="Records" Grid.Row="1" SelectionChanged="Selection_Changed" RightTapped="Records_RightTapped" DoubleTapped="Records_DoubleTapped" PreviewKeyDown="Records_PreviewKeyDown" HorizontalContentAlignment="Stretch" AutomationProperties.Name="回收站文件" ItemContainerStyle="{StaticResource FwListRecordItemStyle}"><ListView.ItemTemplate><DataTemplate x:DataType="local:TrashRow"><ui:FwResourceRow IconName="{x:Bind IconName}" Title="{x:Bind Name}" Detail="{x:Bind RowDetail}" Summary="{x:Bind RowSummary}"/></DataTemplate></ListView.ItemTemplate></ListView>
   <ui:FwEmptyState x:Name="EmptyHost" Grid.Row="1" IconName="trash" Title="回收站为空">
    <ui:FwEmptyState.Action><Button x:Name="ReadRetryButton" Content="重试读取" Visibility="Collapsed" Click="Refresh_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="重试读取回收站" AutomationProperties.AutomationId="TrashReadRetry"/></ui:FwEmptyState.Action>
   </ui:FwEmptyState>
  </Grid>
  <ui:FwDisclosure x:Name="PendingPanel" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Stretch" Header="需要核实的操作"><ui:FwDisclosure.SectionContent><StackPanel Spacing="8"><ListView x:Name="UnknownRecords" SelectionChanged="Selection_Changed" DisplayMemberPath="Label" MaxHeight="150"><ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource FwListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,4"/></Style></ListView.ItemContainerStyle></ListView><Button x:Name="ReconcileButton" Content="核实所选操作" Click="Reconcile_Click" HorizontalAlignment="Left" Style="{StaticResource FwSecondaryButtonStyle}"/></StackPanel></ui:FwDisclosure.SectionContent></ui:FwDisclosure>
  <InfoBar x:Name="Notice" Grid.Row="3" IsOpen="False" IsClosable="True" Severity="Warning" AutomationProperties.AutomationId="TrashNotice">
   <InfoBar.Content><TextBlock x:Name="RestoredPathBlock" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="TrashRestoredPath"/></InfoBar.Content>
  </InfoBar>
  <InfoBar x:Name="StatusToast" Grid.Row="1" Canvas.ZIndex="5" IsOpen="False" IsClosable="True" Severity="Success"
           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,12,12,0" MaxWidth="400"/>
 </Grid>
</UserControl>
