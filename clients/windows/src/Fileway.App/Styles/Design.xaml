      <StaticResource x:Key="FwSurfaceRaisedBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="FwSurfaceHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
      <StaticResource x:Key="FwStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwStrokeStrongBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwTextPrimaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwTextSecondaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwTextTertiaryBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwScrimTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwScrimMutedBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwDangerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
      <StaticResource x:Key="FwShadowBrush" ResourceKey="SystemColorWindowColorBrush" />
      <StaticResource x:Key="FwChromeBrush" ResourceKey="SystemColorWindowColorBrush" />
