      <SolidColorBrush x:Key="FwSurfaceRaisedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="FwSurfaceHoverBrush" Color="#FFF0F2F6" />
      <SolidColorBrush x:Key="FwStrokeBrush" Color="#14000000" />
      <SolidColorBrush x:Key="FwStrokeStrongBrush" Color="#29000000" />
      <SolidColorBrush x:Key="FwTextPrimaryBrush" Color="#FF1B1F24" />
      <SolidColorBrush x:Key="FwTextSecondaryBrush" Color="#FF5C6470" />
      <SolidColorBrush x:Key="FwTextTertiaryBrush" Color="#FF8A929E" />
      <SolidColorBrush x:Key="FwScrimTextBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="FwScrimMutedBrush" Color="#FFD5DAE1" />
      <SolidColorBrush x:Key="FwDangerBrush" Color="#FFC42B1C" />
      <SolidColorBrush x:Key="FwShadowBrush" Color="#33000000" />
      <AcrylicBrush x:Key="FwChromeBrush" TintColor="#F7F8FA" TintOpacity="0.62" TintLuminosityOpacity="0.85" FallbackColor="#E6F7F8FA" />
      <AcrylicBrush x:Key="FwPanelBrush" TintColor="#FBFCFD" TintOpacity="0.80" TintLuminosityOpacity="0.90" FallbackColor="#F2FBFCFD" />
      <AcrylicBrush x:Key="FwScrimBrush" TintColor="#F2F4F7" TintOpacity="0.70" TintLuminosityOpacity="0.86" FallbackColor="#E6F2F4F7" />
