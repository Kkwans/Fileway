      <SolidColorBrush x:Key="FwSurfaceRaisedBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="FwSurfaceHoverBrush" Color="#FFF0F2F6" />
      <SolidColorBrush x:Key="FwStrokeBrush" Color="#14000000" />
      <SolidColorBrush x:Key="FwStrokeStrongBrush" Color="#29000000" />
      <SolidColorBrush x:Key="FwTextPrimaryBrush" Color="#FF1B1F24" />
      <SolidColorBrush x:Key="FwTextSecondaryBrush" Color="#FF5C6470" />
