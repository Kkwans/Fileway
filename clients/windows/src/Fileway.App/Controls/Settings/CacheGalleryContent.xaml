<UserControl x:Class="Fileway.App.Controls.Settings.CacheGalleryContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" MaxWidth="480">
        <TextBlock Text="当前账户 · 本机缓存。图库只读取已缓存的完整缩略图，可在断网时查看。"
                   Style="{StaticResource FwCaptionTextStyle}" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="CacheGalleryStatus"
                   AutomationProperties.LiveSetting="Polite"/>
        <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed"/>
        <Grid x:Name="Tiles" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        </Grid>
        <Border x:Name="PreviewSurface" Visibility="Collapsed" Style="{StaticResource FwFormCardStyle}">
            <Image x:Name="PreviewImage" Height="216" Stretch="Uniform" AutomationProperties.Name="本机缓存缩略图预览"/>
        </Border>
        <Grid x:Name="GalleryActions" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                    AutomationProperties.AutomationId="RefreshCacheGallery"/>
            <StackPanel x:Name="Pager" Grid.Column="1" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                <Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                        AutomationProperties.AutomationId="PreviousCacheGalleryPage"/>
                <Button x:Name="NextButton" Content="下一页" Click="Next_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                        AutomationProperties.AutomationId="NextCacheGalleryPage"/>
            </StackPanel>
        </Grid>
        <Button x:Name="BackButton" Content="返回图库" Click="Back_Click" Style="{StaticResource FwSecondaryButtonStyle}"
                HorizontalAlignment="Right" Visibility="Collapsed" AutomationProperties.AutomationId="ReturnToCacheGallery"/>
    </StackPanel>
</UserControl>
