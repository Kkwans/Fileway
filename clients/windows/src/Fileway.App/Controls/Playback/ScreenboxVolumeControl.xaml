<?xml version="1.0" encoding="utf-8"?>
<!-- Structural port of Screenbox 6870eb0 Controls/VolumeControl.xaml (GPL-3.0).
     Fileway uses native Fluent volume symbols and a 0–200 percent engine range. -->
<UserControl x:Class="Fileway.App.Controls.Playback.ScreenboxVolumeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App.Controls.Playback" RequestedTheme="Dark">
    <Grid x:Name="VolumeLayout" Width="284" Padding="12" ColumnSpacing="8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ValueColumn" Width="40"/></Grid.ColumnDefinitions>
        <ToggleButton x:Name="MuteToggle" Padding="0" Width="40" Height="40" Background="Transparent" BorderThickness="0" UseSystemFocusVisuals="True" Click="Mute_Click" ToolTipService.ToolTip="静音" AutomationProperties.Name="静音">
            <ToggleButton.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorPrimaryBrush"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SystemColorHighlightColorBrush"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SystemColorHighlightColorBrush"/>
                            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SystemColorHighlightColorBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="SystemColorHighlightTextColorBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="SystemColorHighlightTextColorBrush"/>
                            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="SystemColorHighlightTextColorBrush"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ToggleButton.Resources>
            <SymbolIcon x:Name="VolumeGlyph" Symbol="Volume" Width="20" Height="20"/>
        </ToggleButton>
        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="200" SmallChange="5" StepFrequency="1" VerticalAlignment="Center" IsThumbToolTipEnabled="False" ValueChanged="Volume_ValueChanged" AutomationProperties.Name="音量百分比"/>
        <TextBlock x:Name="VolumeValue" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" AutomationProperties.AccessibilityView="Raw"/>
    </Grid>
</UserControl>
