<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="Fileway.App.Controls.Collections.ResourceCollectionsControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Fileway.App.Controls.Collections">
 <UserControl.Resources><DataTemplate x:Key="TagColorTemplate"><StackPanel Orientation="Horizontal" Spacing="10"><Ellipse Width="14" Height="14" Fill="{Binding Brush}"/><TextBlock Text="{Binding Label}"/></StackPanel></DataTemplate></UserControl.Resources>
 <Grid Padding="28,24,28,18" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="4"><TextBlock x:Name="CollectionHeading" Text="收藏与标签" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="CurrentResourceText" Text="从文件列表选择一个项目，可在这里收藏或设置标签。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  <CommandBar Grid.Row="1" DefaultLabelPosition="Right" Background="Transparent">
   <AppBarButton Icon="Back" Label="返回文件" Click="Close_Click"/>
   <AppBarButton x:Name="RefreshButton" Icon="Refresh" Label="刷新" Click="Refresh_Click"/>
   <AppBarButton x:Name="AddFavoriteButton" Icon="Favorite" Label="收藏选中资源" Click="AddFavorite_Click"/>
   <AppBarButton x:Name="ResourceTagsButton" Icon="Tag" Label="设置资源标签" Click="ResourceTags_Click"/>
   <CommandBar.SecondaryCommands><AppBarButton x:Name="CreateGroupButton" Label="新建分组" Click="CreateGroup_Click"/><AppBarButton x:Name="CreateTagButton" Label="新建标签" Click="CreateTag_Click"/></CommandBar.SecondaryCommands>
  </CommandBar>
  <InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="False"/>
  <StackPanel x:Name="ManagementSelection" Grid.Row="3" Spacing="8">
   <ComboBox x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="Mode_Changed" AutomationProperties.Name="收藏或标签视图"><ComboBoxItem Content="收藏"/><ComboBoxItem Content="标签"/></ComboBox>
   <ComboBox x:Name="GroupBox" DisplayMemberPath="Label" HorizontalAlignment="Stretch" SelectionChanged="Group_Changed" AutomationProperties.Name="收藏分组"/>
   <CommandBar x:Name="SelectionCommands" DefaultLabelPosition="Right" Background="Transparent">
    <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="打开" Click="Open_Click"/>
    <AppBarButton x:Name="EditButton" Icon="Edit" Label="编辑" Click="Edit_Click"/>
    <AppBarButton x:Name="RemoveButton" Icon="Remove" Label="移除" Click="Remove_Click"/>
    <CommandBar.SecondaryCommands><AppBarButton x:Name="EditGroupButton" Label="编辑当前分组" Click="EditGroup_Click"/><AppBarButton x:Name="RemoveGroupButton" Label="删除当前分组" Click="RemoveGroup_Click"/></CommandBar.SecondaryCommands>
   </CommandBar>
  </StackPanel>
  <Grid Grid.Row="4" RowSpacing="12"><Grid.RowDefinitions><RowDefinition x:Name="RecordsRow" Height="*"/><RowDefinition x:Name="TagResourcesRow" Height="0"/></Grid.RowDefinitions>
   <ListView x:Name="Records" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="Record_Changed" DoubleTapped="Records_DoubleTapped" KeyDown="Records_KeyDown" AutomationProperties.Name="收藏或标签列表">
    <ListView.ContextFlyout><MenuFlyout><MenuFlyoutItem x:Name="ContextOpen" Text="打开选中资源" Click="Open_Click"/><MenuFlyoutItem x:Name="ContextEdit" Text="编辑选中记录" Click="Edit_Click"/><MenuFlyoutItem x:Name="ContextRemove" Text="移除选中记录" Click="Remove_Click"/></MenuFlyout></ListView.ContextFlyout>
    <ListView.ItemTemplate><DataTemplate x:DataType="local:CollectionRow"><StackPanel Padding="8,10" Spacing="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Ellipse Width="12" Height="12" Margin="0,0,8,0" Fill="{x:Bind TagColorBrush}" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1" Visibility="{x:Bind TagColorVisibility}" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/><TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></Grid><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind State}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyText" Text="暂无收藏。可从文件列表选择资源后添加。" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16"/>
   <Grid x:Name="TagResourcesArea" Grid.Row="1" Visibility="Collapsed" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <CommandBar DefaultLabelPosition="Right" Background="Transparent"><CommandBar.Content><TextBlock Text="标签关联资源" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/></CommandBar.Content><AppBarButton x:Name="OpenTagResourceButton" Icon="OpenFile" Label="打开资源" Click="OpenTagResource_Click"/><AppBarButton x:Name="UnlinkButton" Icon="Remove" Label="取消关联" Click="Unlink_Click"/></CommandBar>
    <ListView x:Name="TagResources" Grid.Row="1" SelectionMode="Single" HorizontalContentAlignment="Stretch" SelectionChanged="TagResource_Changed" DoubleTapped="TagResources_DoubleTapped" KeyDown="TagResources_KeyDown" AutomationProperties.Name="标签关联资源列表"><ListView.ItemTemplate><DataTemplate x:DataType="local:CollectionRow"><StackPanel Padding="8,10" Spacing="4"><TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind State}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
    <TextBlock x:Name="TagEmptyText" Grid.Row="1" Text="选择标签以查看关联资源。" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="16"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
