<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Fileway.App.Views.StorageSettingsControl" xmlns:ui="using:Fileway.App.Controls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="BodyScroll" MaxHeight="520" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" MinWidth="280" MaxWidth="480" Padding="0,0,0,16">
            <TextBlock Text="设置本机缓存和默认下载位置。缓存目录变更将在下次启动后生效。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <InfoBar x:Name="StatusNotice" IsOpen="True" IsClosable="False" Severity="Informational" Message="正在读取存储设置…"/>
            <ContentControl x:Name="SettingsFields" IsEnabled="False" HorizontalContentAlignment="Stretch">
              <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="当前生效" FontSize="15" FontWeight="SemiBold"/>
                    <StackPanel x:Name="ActiveSettingsPanel" Spacing="6"/>
                </StackPanel>
                <TextBlock Text="保存配置" FontSize="15" FontWeight="SemiBold"/>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="缓存根目录"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="CacheDirectoryBox" IsReadOnly="True" AutomationProperties.Name="缓存根目录"/>
                        <Button Grid.Column="1" Content="选择…" Click="ChooseCache_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="选择缓存根目录"/>
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="磁盘缓存总容量（GB）"/>
                    <NumberBox x:Name="MaximumCacheGbBox" Minimum="0" Value="5" SmallChange="1" SpinButtonPlacementMode="Compact" AutomationProperties.Name="磁盘缓存总容量，单位GB"/>
                </StackPanel>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="默认 5 GB；1 GB = 1,000,000,000 字节。设为 0 关闭磁盘缓存，不影响播放器内存预加载。" TextWrapping="Wrap"/>
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="默认下载目录"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadDirectoryBox" IsReadOnly="True" AutomationProperties.Name="默认下载目录"/>
                        <Button Grid.Column="1" Content="选择…" Click="ChooseDownload_Click" Style="{StaticResource FwSecondaryButtonStyle}" AutomationProperties.Name="选择默认下载目录"/>
                    </Grid>
                </StackPanel>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="单文件下载使用已生效的默认目录，开始前会显示实际保存位置。目录变更在重启后生效；下载文件独立于缓存，不参与缓存清理。" TextWrapping="Wrap"/>
                <ToggleSwitch x:Name="AutoResumeBox" Header="连接后自动继续未完成的下载" OffContent="手动继续" OnContent="自动继续" AutomationProperties.Name="连接后自动继续未完成的下载"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="开启后，每次连接时会把上次中断、仍有可靠续传证据的下载重新排队，从已确认的保存位置继续并核对远端版本。默认关闭，保持手动继续。" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" x:Name="PendingSettingsText" TextWrapping="Wrap"/>
              </StackPanel>
            </ContentControl>
            <StackPanel Spacing="6">
                <TextBlock Text="缓存占用" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="CacheUsageText" Text="正在读取当前缓存池占用…" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" x:Name="CacheBlocksText" Text="缓存块与受保护状态尚未读取。" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" x:Name="PreviousRootsText" Text="旧缓存根目录额外占用尚未读取。" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="旧缓存根目录额外占用不计入当前池容量；不可用目录未计入统计。" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource FwCaptionTextStyle}" Text="清理仅移除已识别且未使用的缓存，保留活跃播放缓存、下载文件和未知文件。" TextWrapping="Wrap"/>
                <InfoBar x:Name="CacheNotice" IsOpen="False" IsClosable="False" Severity="Informational"/>
                <ContentControl x:Name="CacheActions" IsEnabled="False" HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Click="RefreshCache_Click" AutomationProperties.Name="刷新缓存占用" Style="{StaticResource FwTextIconButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/><TextBlock Text="刷新"/></StackPanel></Button>
                        <Button Click="ClearCache_Click" AutomationProperties.Name="清理未使用缓存" Style="{StaticResource FwTextIconButtonStyle}"><StackPanel Orientation="Horizontal" Spacing="8"><ui:LucideIcon IconName="trash" Width="16" Height="16"/><TextBlock Text="清理未使用缓存"/></StackPanel></Button>
                    </StackPanel>
                </ContentControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{ThemeResource FwStrokeBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button x:Name="CloseButton" Content="关闭" Width="120" Click="Close_Click" Style="{StaticResource FwSecondaryButtonStyle}"/><Button x:Name="SaveButton" Content="保存" Width="120" Click="Save_Click" IsEnabled="False" Style="{StaticResource FwPrimaryButtonStyle}"/></StackPanel>
    </Border></Grid>
</UserControl>
