<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Fileway.App.MainPage" xmlns:ui="using:Fileway.App.Controls" Background="Transparent" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Fileway.App" xmlns:collections="using:Fileway.App.Controls.Collections" xmlns:browser="using:Fileway.App.Controls.Browser" xmlns:transfers="using:Fileway.App.Controls.Transfers" xmlns:recent="using:Fileway.App.Controls.Recent" xmlns:search="using:Fileway.App.Controls.Search" xmlns:nasTasks="using:Fileway.App.Controls.NasTasks" xmlns:trash="using:Fileway.App.Controls.Trash" xmlns:storageTools="using:Fileway.App.Controls.StorageTools">
 <Page.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="FileContentSurfaceBrush" Color="#FF1B1D21"/>
     <SolidColorBrush x:Key="FileContentEdgeBrush" Color="#18FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="FileContentSurfaceBrush" Color="#FFFFFFFF"/>
     <SolidColorBrush x:Key="FileContentEdgeBrush" Color="#10000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="FileContentSurfaceBrush" Color="#FF1B1D21"/>
     <SolidColorBrush x:Key="FileContentEdgeBrush" Color="#18FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="FileContentSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
     <SolidColorBrush x:Key="FileContentEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="LayoutChoiceStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="ApplicationMenuItemStyle" TargetType="MenuBarItem"><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="12,4"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="BrowserActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="BrowserNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="0"/></Style>
  <Style x:Key="SidebarNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="CornerRadius" Value="4"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="SidebarSelectedNavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarNavigationButtonStyle}"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="BrowserListItemStyle" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,0"/><Setter Property="MinHeight" Value="52"/><Setter Property="CornerRadius" Value="4"/></Style>
  <DataTemplate x:Key="BrowserGridTemplate" x:DataType="local:FileRow"><Grid Padding="8" RowSpacing="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Width="{x:Bind VisualSize}" Height="{x:Bind VisualSize}" HorizontalAlignment="Center"><ui:LucideIcon x:Name="ThumbnailIcon" IconName="{x:Bind IconName}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/><Image x:Name="ThumbnailImage" Width="{x:Bind VisualSize}" Height="{x:Bind VisualSize}" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></Grid>
   <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="14" TextAlignment="Center" HorizontalAlignment="Stretch" TextWrapping="Wrap" MaxLines="2" MinHeight="40" LineHeight="20" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
   <StackPanel Grid.Row="2" Spacing="2" Visibility="{x:Bind GridMetadataVisibility}"><TextBlock Text="{x:Bind Summary}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind Modified}" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid></DataTemplate>
  <DataTemplate x:Key="BrowserCompactListTemplate" x:DataType="local:FileRow"><Grid Padding="8,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Width="32" Height="32"><ui:LucideIcon x:Name="ThumbnailIcon" IconName="{x:Bind IconName}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/><Image x:Name="ThumbnailImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></Grid>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Metadata}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind Metadata}"/></StackPanel>
  </Grid></DataTemplate>
  </ResourceDictionary>
 </Page.Resources>
 <Grid x:Name="Shell" Background="Transparent" SizeChanged="Shell_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- MainWindow hosts the pane toggle and application menus together in the caption. -->
  <StackPanel x:Name="ApplicationCommandHost" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
   <Button x:Name="PaneButton" Style="{StaticResource BrowserNavigationButtonStyle}" Click="Pane_Click" AutomationProperties.Name="折叠导航侧栏" ToolTipService.ToolTip="折叠导航侧栏 (Ctrl+B)"><ui:LucideIcon IconName="sidebar-simple" Width="16" Height="16"/></Button>
   <MenuBar x:Name="ApplicationMenus" Height="40" MinHeight="40" Padding="0" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" GettingFocus="ApplicationMenus_GettingFocus" PointerEntered="ApplicationMenus_PointerEntered" AutomationProperties.Name="应用菜单">
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="文件" AccessKey="F">
    <MenuFlyoutItem x:Name="MenuConnectionItem" Text="连接服务器…" Click="Connection_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuOpenItem" Text="打开" Click="DetailsOpen_Click" IsEnabled="False"/>
    <MenuFlyoutSubItem x:Name="MenuNewItem" Text="新建" IsEnabled="False"><MenuFlyoutItem Text="文件夹…" Click="CreateDirectory_Click"/><MenuFlyoutItem x:Name="MenuNewFileItem" Text="空文件…" Click="CreateEmptyFile_Click"/></MenuFlyoutSubItem>
    <MenuFlyoutItem x:Name="MenuUploadItem" Text="上传文件…" Click="UploadFile_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuDownloadItem" Text="下载到默认目录…" Click="DownloadFile_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuSaveAsItem" Text="下载另存为…" Click="DownloadSaveAs_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="LogoutButton" Text="退出登录" Visibility="Collapsed" Click="Logout_Click"/>
    <MenuFlyoutItem Text="退出" Click="ApplicationExit_Click"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="编辑" AccessKey="E">
    <MenuFlyoutItem x:Name="MenuClipboardCopyItem" Text="复制" Click="CopyClipboard_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClipboardCutItem" Text="剪切" Click="CutClipboard_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClipboardPasteItem" Text="粘贴" Click="PasteClipboard_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuRenameItem" Text="重命名…" Click="Rename_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuCopyItem" Text="复制到…" Click="CopySelection_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuMoveItem" Text="移动到…" Click="MoveSelection_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTrashItem" Text="移入回收站…" Click="Trash_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuSelectAllItem" Text="全选" Click="SelectAll_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuClearSelectionItem" Text="取消选择" Click="ClearSelection_Click" IsEnabled="False"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="视图" AccessKey="V">
    <MenuFlyoutItem x:Name="MenuRefreshItem" Text="刷新" Click="Refresh_Click" IsEnabled="False"/>
    <ToggleMenuFlyoutItem x:Name="MenuDetailsItem" Text="详细信息" Click="Details_Click" IsEnabled="False"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutSubItem x:Name="MenuLayoutItem" Text="文件布局" IsEnabled="False">
     <RadioMenuFlyoutItem x:Name="MenuMosaicItem" Text="详细网格" Tag="Mosaic" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuCompactGridItem" Text="紧凑网格" Tag="CompactGrid" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuWindowsIconsItem" Text="无界网格" Tag="WindowsIcons" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuDetailsViewItem" Text="详细列表" Tag="Details" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
     <RadioMenuFlyoutItem x:Name="MenuCompactListItem" Text="紧凑列表" Tag="CompactList" GroupName="ApplicationBrowserView" Click="ViewMode_Click"/>
    </MenuFlyoutSubItem>
    <MenuFlyoutSubItem Text="界面主题"><RadioMenuFlyoutItem x:Name="MenuSystemThemeItem" Text="跟随系统" Tag="Default" GroupName="ApplicationTheme" IsChecked="True" Click="ApplicationTheme_Click"/><RadioMenuFlyoutItem x:Name="MenuLightThemeItem" Text="浅色" Tag="Light" GroupName="ApplicationTheme" Click="ApplicationTheme_Click"/><RadioMenuFlyoutItem x:Name="MenuDarkThemeItem" Text="深色" Tag="Dark" GroupName="ApplicationTheme" Click="ApplicationTheme_Click"/></MenuFlyoutSubItem>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="工具" AccessKey="T">
    <MenuFlyoutItem Text="外观与交互…" Click="PresentationSettings_Click"/><ToggleMenuFlyoutItem x:Name="MenuCloseToTrayItem" Text="关闭窗口后保留在托盘" IsChecked="True" Click="CloseToTray_Click"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="MenuServerSearchItem" Text="搜索文件…" Click="ServerSearch_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuRecentItem" Text="最近访问" Click="RecentAccess_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTransfersItem" Text="传输中心" Click="TransferCenter_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuNasTasksItem" Text="文件任务" Click="NasTasks_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="MenuTrashPageItem" Text="回收站" Click="TrashPage_Click" IsEnabled="False"/>
    <MenuFlyoutItem x:Name="CollectionsButton" Text="管理收藏与标签…" Click="Collections_Click" IsEnabled="False" AutomationProperties.Name="管理收藏与标签"/>
    <MenuFlyoutItem x:Name="ChangePasswordButton" Text="修改密码…" Click="ChangePassword_Click" Visibility="Collapsed" AutomationProperties.Name="修改当前账户密码"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem x:Name="StorageSettingsButton" Text="缓存与存储…" Click="StorageSettings_Click" IsEnabled="False" AutomationProperties.Name="缓存与存储设置"/>
   </MenuBarItem>
   <MenuBarItem Style="{StaticResource ApplicationMenuItemStyle}" Title="帮助" AccessKey="H"><MenuFlyoutItem Text="键盘快捷键" Click="KeyboardHelp_Click"/><MenuFlyoutItem Text="关于" Click="AboutApplication_Click"/><MenuFlyoutSeparator/><MenuFlyoutItem x:Name="LanguageFollowItem" Text="语言：跟随系统" Click="LanguageFollow_Click"/><MenuFlyoutItem x:Name="LanguageChineseItem" Text="语言：简体中文" Click="LanguageChinese_Click"/><MenuFlyoutItem x:Name="LanguageEnglishItem" Text="Language: English" Click="LanguageEnglish_Click"/></MenuBarItem>
   </MenuBar>
  </StackPanel>
  <Border x:Name="ContentBackdrop" Grid.Column="1" Grid.RowSpan="2" Background="{ThemeResource FileContentSurfaceBrush}" BorderThickness="0" CornerRadius="8,0,0,0" IsHitTestVisible="False"/>
  <Grid x:Name="NavigationHeader" Grid.Column="1" Height="64" Padding="16,10" ColumnSpacing="8" Background="Transparent">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
    <ContentControl VerticalContentAlignment="Center" VerticalAlignment="Center" x:Name="NavigationCommands" IsEnabled="False" IsTabStop="False"><StackPanel Orientation="Horizontal" Spacing="4">
     <Button x:Name="BackButton" Style="{StaticResource BrowserNavigationButtonStyle}" Click="Back_Click" IsEnabled="False" AutomationProperties.Name="返回" ToolTipService.ToolTip="返回 (Alt+Left)"><ui:LucideIcon IconName="arrow-left" Width="16" Height="16"/></Button>
     <Button x:Name="UpButton" Style="{StaticResource BrowserNavigationButtonStyle}" Click="Up_Click" IsEnabled="False" AutomationProperties.Name="上一级" ToolTipService.ToolTip="上一级 (Alt+Up)"><ui:LucideIcon IconName="arrow-up" Width="16" Height="16"/></Button>
     <Button Style="{StaticResource BrowserNavigationButtonStyle}" Click="Refresh_Click" AutomationProperties.Name="刷新目录" ToolTipService.ToolTip="刷新 (F5)"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/></Button>
    </StackPanel></ContentControl>
   </StackPanel>
   <Grid Grid.Column="1" MinWidth="120">
    <Border x:Name="PathLocationHost" Height="40" Padding="4,0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderThickness="0" CornerRadius="8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <BreadcrumbBar x:Name="PathBreadcrumb" Height="40" VerticalContentAlignment="Center" MinHeight="0" Padding="4,0" FontSize="14" ItemClicked="Breadcrumb_Click" VerticalAlignment="Center" AutomationProperties.Name="目录导航"><BreadcrumbBar.ItemTemplate><DataTemplate><BreadcrumbBarItem Content="{Binding Label}" Height="36" MinHeight="36" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="8,0"/></DataTemplate></BreadcrumbBar.ItemTemplate></BreadcrumbBar>
      <TextBox x:Name="PathBox" Grid.ColumnSpan="2" Visibility="Collapsed" Height="32" MinHeight="32" Padding="8,4" KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus" AutomationProperties.Name="原始路径，按 Enter 导航，Escape 取消" PlaceholderText="原始路径（保留百分号编码）" ToolTipService.ToolTip="原始路径；保留服务器返回的百分号编码。Enter 导航，Escape 取消。"/>
      <Button x:Name="EditPathButton" Grid.Column="1" Style="{StaticResource BrowserNavigationButtonStyle}" Click="EditPath_Click" AutomationProperties.Name="编辑原始路径" ToolTipService.ToolTip="编辑原始路径 (Ctrl+L)"><ui:LucideIcon IconName="pencil-simple" Width="16" Height="16"/></Button>
     </Grid>
    </Border>
    <TextBlock x:Name="WorkspaceTitle" Text="连接服务器" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
   </Grid>
   <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" Width="240" Height="36" MinHeight="36" VerticalAlignment="Center" PlaceholderText="筛选文件或搜索…" QueryIcon="Find" TextChanged="Search_Changed" QuerySubmitted="Search_QuerySubmitted" AutomationProperties.Name="输入筛选当前列表，按 Enter 搜索当前目录及子目录" ToolTipService.ToolTip="输入筛选已加载的列表；Enter 或搜索按钮查询当前目录及子目录 (Ctrl+F)"/>
  </Grid>
  <Grid x:Name="Sidebar" Grid.RowSpan="2" Padding="12,16,12,12" Background="Transparent" Canvas.ZIndex="3">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="SidebarOverlayBackground" Grid.RowSpan="2" Margin="-12,-16,-12,-12" Background="{ThemeResource FileContentSurfaceBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
   <ScrollViewer Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
    <StackPanel Spacing="4">
     <Button x:Name="MyFilesButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="Root_Click" AutomationProperties.Name="我的文件根目录" ToolTipService.ToolTip="我的文件"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="folder" Width="16" Height="16"/><TextBlock x:Name="MyFilesLabel" Text="我的文件"/></StackPanel></Button>
     <Button x:Name="RecentAccessButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="RecentAccess_Click" IsEnabled="False" AutomationProperties.Name="最近访问" ToolTipService.ToolTip="最近访问"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="clock" Width="16" Height="16"/><TextBlock x:Name="RecentAccessLabel" Text="最近访问"/></StackPanel></Button>
     <Button x:Name="TransferCenterButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="TransferCenter_Click" IsEnabled="False" AutomationProperties.Name="传输中心" ToolTipService.ToolTip="传输中心"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="arrows-clockwise" Width="16" Height="16"/><TextBlock x:Name="TransferCenterLabel" Text="传输中心"/></StackPanel></Button>
     <Button x:Name="NasTasksButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="NasTasks_Click" IsEnabled="False" AutomationProperties.Name="文件任务" ToolTipService.ToolTip="文件任务"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="file-code" Width="16" Height="16"/><TextBlock x:Name="NasTasksLabel" Text="文件任务"/></StackPanel></Button>
     <Button x:Name="StorageToolsButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="StorageTools_Click" IsEnabled="False" AutomationProperties.Name="存储工具" ToolTipService.ToolTip="存储工具"><StackPanel Orientation="Horizontal" Spacing="12"><ui:LucideIcon IconName="database" Width="16" Height="16"/><TextBlock Text="存储工具"/></StackPanel></Button>
     <Button x:Name="TrashPageButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="TrashPage_Click" IsEnabled="False" AutomationProperties.Name="回收站" ToolTipService.ToolTip="回收站"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74D;" FontSize="16"/><TextBlock x:Name="TrashPageLabel" Text="回收站"/></StackPanel></Button>
    </StackPanel>
    <browser:SidebarCollectionsControl x:Name="SidebarCollections" IsEnabled="False"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><StackPanel Spacing="4">
    <TextBlock x:Name="ConnectionLabel" Text="尚未连接" FontSize="12" Margin="12,0,12,4" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Name="ConnectionButton" Style="{StaticResource SidebarNavigationButtonStyle}" Click="Connection_Click" AutomationProperties.Name="连接服务器" ToolTipService.ToolTip="连接服务器"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE968;" FontSize="16"/><TextBlock x:Name="SidebarConnectionActionLabel" Text="连接服务器"/></StackPanel></Button>
   </StackPanel></Border>
  </Grid>
  <Button x:Name="SidebarDismiss" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{ThemeResource SmokeFillColorDefaultBrush}" BorderThickness="0" CornerRadius="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Click="PaneDismiss_Click" Canvas.ZIndex="2" AutomationProperties.Name="关闭导航侧栏"/>
  <browser:SidebarResizeThumb x:Name="SidebarResize" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="8" HorizontalAlignment="Left" VerticalAlignment="Stretch" DragDelta="SidebarResize_DragDelta" KeyDown="SidebarResize_KeyDown" IsTabStop="True" UseSystemFocusVisuals="True" Canvas.ZIndex="4" AutomationProperties.Name="调整导航侧栏宽度，方向键调整" ToolTipService.ToolTip="拖动调整侧栏宽度，或使用左右方向键"/>
  <Border x:Name="WorkspaceSurface" Grid.Row="1" Grid.Column="1" Background="Transparent" BorderThickness="0">
  <Grid>
  <Grid x:Name="Workspace" Visibility="Collapsed" Padding="16,0,16,0" RowSpacing="0" SizeChanged="Workspace_SizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
   <CommandBar x:Name="BrowserCommands" Height="44" DefaultLabelPosition="Collapsed" Background="Transparent" HorizontalContentAlignment="Stretch">
    <CommandBar.Content><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <ui:ChoiceBox x:Name="SortBox" SelectedIndex="0" Width="140" Height="36" MinHeight="36" SelectionChanged="Sort_Changed" AutomationProperties.Name="文件排序"><ComboBoxItem Content="名称 ↑"/><ComboBoxItem Content="名称 ↓"/><ComboBoxItem Content="修改时间 ↑"/><ComboBoxItem Content="修改时间 ↓"/><ComboBoxItem Content="大小 ↑"/><ComboBoxItem Content="大小 ↓"/><ComboBoxItem Content="类型 ↑"/><ComboBoxItem Content="类型 ↓"/></ui:ChoiceBox>
     <DropDownButton x:Name="TypeFilterBox" Style="{StaticResource FilewaySelectorButtonStyle}" Content="全部类型" Width="148" Height="36" AutomationProperties.Name="文件类型筛选，可多选"><DropDownButton.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><StackPanel Width="224" Spacing="4"><TextBlock Text="文件类型 · 可多选" Margin="12,4,0,8" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <ToggleButton Content="全部类型" Tag="All" IsChecked="True" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="图片" Tag="Image" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="音频" Tag="Audio" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="视频" Tag="Video" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="PDF" Tag="Pdf" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="Markdown" Tag="Markdown" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="配置文件" Tag="Config" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
      <ToggleButton Content="代码文件" Tag="Code" Style="{StaticResource LayoutChoiceStyle}" Click="TypeFilter_Click"/>
     </StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
     <DropDownButton x:Name="ViewOptionsButton" Style="{StaticResource FilewaySelectorButtonStyle}" Content="详细网格" Height="36" MinWidth="140" AutomationProperties.Name="文件布局"><DropDownButton.Flyout><Flyout Placement="BottomEdgeAlignedLeft"><StackPanel Width="224" Spacing="4">
      <ToggleButton x:Name="MosaicViewItem" Content="详细网格" Tag="Mosaic" Style="{StaticResource LayoutChoiceStyle}" Click="ViewMode_Click"/>
      <ToggleButton x:Name="CompactGridViewItem" Content="紧凑网格" Tag="CompactGrid" Style="{StaticResource LayoutChoiceStyle}" Click="ViewMode_Click"/>
      <ToggleButton x:Name="WindowsIconsViewItem" Content="无界网格" Tag="WindowsIcons" Style="{StaticResource LayoutChoiceStyle}" Click="ViewMode_Click"/>
      <ToggleButton x:Name="DetailsViewItem" Content="详细列表" Tag="Details" Style="{StaticResource LayoutChoiceStyle}" Click="ViewMode_Click"/>
      <ToggleButton x:Name="CompactListViewItem" Content="紧凑列表" Tag="CompactList" Style="{StaticResource LayoutChoiceStyle}" Click="ViewMode_Click"/>
      <StackPanel x:Name="IconSizesMenu" Spacing="4" Margin="0,12,0,0"><TextBlock Text="图标大小" FontSize="12" Margin="12,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
       <ToggleButton x:Name="SmallIconItem" Content="小" Tag="Small" Style="{StaticResource LayoutChoiceStyle}" Click="IconSize_Click"/>
       <ToggleButton x:Name="MediumIconItem" Content="中" Tag="Medium" Style="{StaticResource LayoutChoiceStyle}" Click="IconSize_Click"/>
       <ToggleButton x:Name="LargeIconItem" Content="大" Tag="Large" Style="{StaticResource LayoutChoiceStyle}" Click="IconSize_Click"/>
       <ToggleButton x:Name="ExtraLargeIconItem" Content="超大" Tag="ExtraLarge" Style="{StaticResource LayoutChoiceStyle}" Click="IconSize_Click"/>
      </StackPanel>
     </StackPanel></Flyout></DropDownButton.Flyout></DropDownButton>
    </StackPanel></CommandBar.Content>
    <AppBarButton x:Name="NewButton" Label="新建" Height="40" IsEnabled="False" ToolTipService.ToolTip="新建"><AppBarButton.Icon><ui:LucideActionIcon IconName="plus"/></AppBarButton.Icon><AppBarButton.Flyout><MenuFlyout><MenuFlyoutItem Text="文件夹" Click="CreateDirectory_Click"/><MenuFlyoutItem x:Name="NewFileMenuItem" Text="空文件" Click="CreateEmptyFile_Click"/></MenuFlyout></AppBarButton.Flyout></AppBarButton>
    <AppBarButton x:Name="UploadFileButton" Label="上传文件" Height="40" IsEnabled="False" ToolTipService.ToolTip="上传本地文件或整个文件夹到当前目录"><AppBarButton.Icon><ui:LucideActionIcon IconName="upload-simple"/></AppBarButton.Icon><AppBarButton.Flyout><MenuFlyout><MenuFlyoutItem Text="选择文件…" Click="UploadFile_Click"/><MenuFlyoutItem Text="选择文件夹…" Click="UploadFolder_Click"/></MenuFlyout></AppBarButton.Flyout></AppBarButton>
    <AppBarButton x:Name="DownloadFileButton" Label="下载" Height="40" IsEnabled="False" Click="DownloadFile_Click" ToolTipService.ToolTip="下载选中的文件到已生效的默认下载目录"><AppBarButton.Icon><ui:LucideActionIcon IconName="download-simple"/></AppBarButton.Icon></AppBarButton>
    <CommandBar.SecondaryCommands><AppBarButton x:Name="DownloadHistoryButton" Label="下载记录" Click="DownloadHistory_Click" IsEnabled="False"><AppBarButton.Icon><ui:LucideActionIcon IconName="clock"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="UploadHistoryButton" Label="上传记录" Click="UploadHistory_Click" IsEnabled="False"><AppBarButton.Icon><ui:LucideActionIcon IconName="clock"/></AppBarButton.Icon></AppBarButton><AppBarButton Label="详细信息" Click="Details_Click"><AppBarButton.Icon><ui:LucideActionIcon IconName="eye"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="FavoriteActionButton" Label="收藏" Click="FavoriteResource_Click" IsEnabled="False"><AppBarButton.Icon><ui:LucideActionIcon IconName="heart"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="TagActionButton" Label="标记" Click="TagResource_Click" IsEnabled="False"><AppBarButton.Icon><ui:LucideActionIcon IconName="tag"/></AppBarButton.Icon></AppBarButton><AppBarButton x:Name="LastResultsButton" Label="上次操作的完整结果" Click="ResultDetails_Click" IsEnabled="False"/></CommandBar.SecondaryCommands>
   </CommandBar>

   <Grid x:Name="BrowserBody" Grid.Row="2" SizeChanged="BrowserBody_SizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="DetailsRow" Height="0"/></Grid.RowDefinitions>
    <Grid x:Name="FilesArea" SizeChanged="FilesArea_SizeChanged" RightTapped="FilesArea_RightTapped" Background="Transparent" AllowDrop="True" DragOver="FilesArea_DragOver" DragLeave="FilesArea_DragLeave" Drop="FilesArea_Drop"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="ListHeader" Padding="56,8,16,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBlock Text="名称" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Grid.Column="1" Text="大小 / 修改时间" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
    <ListView x:Name="FileList" Grid.Row="1" ItemContainerStyle="{StaticResource BrowserListItemStyle}" SelectionMode="Extended" DoubleTapped="FileList_DoubleTapped" PreviewKeyDown="FileList_PreviewKeyDown" KeyDown="FileList_KeyDown" RightTapped="FileResource_RightTapped" SelectionChanged="FileList_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="文件列表">
     <ListView.ItemTemplate><DataTemplate x:DataType="local:FileRow"><Grid Padding="8,4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
      <Grid Width="32" Height="32" VerticalAlignment="Center"><ui:LucideIcon x:Name="ThumbnailIcon" IconName="{x:Bind IconName}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/><Image x:Name="ThumbnailImage" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/></Grid>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Kind}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{x:Bind Size}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="{x:Bind Modified}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <GridView x:Name="FileGrid" Grid.Row="1" Visibility="Collapsed" SelectionMode="Extended" DoubleTapped="FileList_DoubleTapped" PreviewKeyDown="FileList_PreviewKeyDown" KeyDown="FileList_KeyDown" RightTapped="FileResource_RightTapped" SelectionChanged="FileList_SelectionChanged" AutomationProperties.Name="文件网格" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemTemplate="{StaticResource BrowserGridTemplate}">
     <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="4"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" ItemWidth="176" ItemHeight="160"/></ItemsPanelTemplate></GridView.ItemsPanel>
    </GridView>
    <StackPanel x:Name="EmptyState" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="420" Margin="16"><ui:LucideIcon IconName="folder" Width="42" Height="42" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="EmptyTitle" Text="你的文件，在这里相遇" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock x:Name="EmptyDescription" Text="连接服务器后即可浏览文件、打开图片和播放视频。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/><Button x:Name="RetryLoadButton" Content="重新加载" Click="Refresh_Click" Visibility="Collapsed" HorizontalAlignment="Center"/></StackPanel>
    <ProgressRing x:Name="LoadingRing" Grid.RowSpan="2" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Border x:Name="DropOverlay" Grid.RowSpan="2" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="2" CornerRadius="8" Margin="6" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Background="{ThemeResource AccentFillColorSecondaryBrush}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><ui:LucideIcon IconName="upload-simple" Width="34" Height="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DropOverlayText" Text="松开以上传到当前目录" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></Border>
    </Grid>
    <Border x:Name="DetailsPanel" Visibility="Collapsed" Padding="20" Background="Transparent" KeyDown="DetailsPanel_KeyDown">
     <Grid RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文件详情" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Click="CloseDetails_Click" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="0" AutomationProperties.Name="关闭详细信息" ToolTipService.ToolTip="关闭"><ui:LucideIcon IconName="x" Width="20" Height="20"/></Button></Grid>
      <ScrollViewer Grid.Row="1" MaxHeight="380" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16">
       <ui:LucideIcon x:Name="DetailsFileIcon" IconName="file" Width="48" Height="48" HorizontalAlignment="Left"/>
       <TextBlock x:Name="DetailsName" Text="选择一个项目" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
       <StackPanel Spacing="4"><TextBlock Text="位置" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock x:Name="DetailsPath" FontSize="14" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel>
       <TextBlock x:Name="DetailsMetadata" FontSize="14" LineHeight="26" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
      </StackPanel></ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
       <Button x:Name="DetailsOpenButton" Click="DetailsOpen_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="打开" AutomationProperties.Name="打开"><ui:LucideIcon IconName="folder-open" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsDownloadButton" Click="DownloadFile_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="下载" AutomationProperties.Name="下载"><ui:LucideIcon IconName="download-simple" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsCopyButton" Click="CopyClipboard_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="复制文件" AutomationProperties.Name="复制文件"><ui:LucideIcon IconName="copy" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsCutButton" Click="CutClipboard_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="剪切文件" AutomationProperties.Name="剪切文件"><ui:LucideIcon IconName="scissors" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsRenameButton" Click="Rename_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="重命名" AutomationProperties.Name="重命名"><ui:LucideIcon IconName="pencil-simple" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsMoveButton" Click="MoveSelection_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="移动到" AutomationProperties.Name="移动到"><ui:LucideIcon IconName="folder" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsFavoriteButton" Click="FavoriteResource_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="收藏" AutomationProperties.Name="收藏"><ui:LucideIcon IconName="heart" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsTagButton" Click="TagResource_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="设置标签" AutomationProperties.Name="设置标签"><ui:LucideIcon IconName="tag" Width="20" Height="20"/></Button>
       <Button x:Name="DetailsTrashButton" Click="Trash_Click" Style="{StaticResource BrowserActionButtonStyle}" ToolTipService.ToolTip="移入回收站" AutomationProperties.Name="移入回收站"><ui:LucideIcon IconName="trash" Width="20" Height="20"/></Button>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Height="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12" Text="尚未连接" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/><Button x:Name="CancelButton" Grid.Column="1" Content="取消加载" Style="{StaticResource SubtleButtonStyle}" FontSize="12" Height="24" MinHeight="24" Padding="8,0" Visibility="Collapsed" Click="Cancel_Click"/></Grid>
  </Grid>
  <recent:RecentAccessControl x:Name="RecentPane" Visibility="Collapsed"/>
