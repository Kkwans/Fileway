<?xml version="1.0" encoding="utf-8"?>
<!-- Screenbox CompositeTrackPicker.xaml (6870eb0, GPL-3.0), adapted to
     confirmed Fileway track records and a fixed local subtitle action. -->
<UserControl x:Class="Fileway.App.Controls.Playback.ScreenboxTrackPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:Fileway.App.Controls" Width="328" RequestedTheme="Dark">
    <Grid Padding="4,0,4,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid MinHeight="44" Margin="16,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="Heading" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
        </Grid>
        <ListView x:Name="Tracks" Grid.Row="1" Margin="0,4,0,0" MaxHeight="336"
                  SelectionMode="Single" SingleSelectionFollowsFocus="False" ItemContainerTransitions="{x:Null}"
                  ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionChanged="Tracks_SelectionChanged"/>
        <Grid x:Name="SubtitleActions" Grid.Row="2" Margin="8,4,8,0" Padding="0,4,0,0" Visibility="Collapsed"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Button x:Name="AddSubtitleButton" Click="AddSubtitle_Click"
                    Height="40" MinHeight="40" Padding="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Style="{StaticResource FwSecondaryButtonStyle}" BorderBrush="{ThemeResource FwStrokeStrongBrush}"
                    AutomationProperties.Name="添加本地字幕">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ui:LucideIcon IconName="plus" Width="16" Height="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                    <TextBlock Text="添加本地字幕…" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
